---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageTools from '../components/ImageTools.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import SchemaOrg from '../components/SchemaOrg.astro';

const pageTitle = 'Crop Images Online — Free Image Cropper Tool';
const pageDesc = 'Crop images online for free. Remove unwanted areas, focus on the subject. Precise pixel-level control. No uploads, 100% private, instant browser-based cropping.';
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <SchemaOrg type="SoftwareApplication" data={{ name: 'Image Cropper', description: pageDesc, features: ['Pixel-precise cropping','X/Y coordinate control','Batch cropping','Aspect ratio support','Instant preview'] }} />
  <SchemaOrg type="BreadcrumbList" data={{ items: [{ name: 'Home', item: new URL('/', Astro.url).href }, { name: 'Crop', item: new URL('/crop', Astro.url).href }] }} />
  <section class="relative overflow-hidden border-b border-border-secondary bg-surface-primary">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-accent-soft/30 via-transparent to-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Crop Tool</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-text-primary sm:text-5xl lg:text-6xl">
        Crop images — trim the perfect frame
      </h1>
      <p class="mt-5 max-w-2xl mx-auto text-lg leading-relaxed text-text-secondary">
        Remove unwanted edges and focus on what matters. Set exact X/Y coordinates and dimensions. All processing happens in your browser — private and instant.
      </p>
    </div>
  </section>
  <section class="bg-surface-secondary">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
      <ImageTools initialTool="crop" />
    </div>
  </section>
  <section class="bg-surface-primary">
    <div class="mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent text-center">FAQ</p>
      <h2 class="mt-3 text-center text-3xl font-extrabold tracking-tight text-text-primary sm:text-4xl">Frequently asked questions</h2>
      <div class="mt-10">
        <FAQAccordion items={[
          { question: 'How do I undo an active crop selection?', answer: 'Click the "Undo Crop" button next to the aspect ratio presets, or click "Full Image" at the bottom of the crop panel. Both restore the full uncropped image. You can also switch to the Filters tab and click "Reset" to clear all modifications.' },
          { question: 'Can I crop to specific aspect ratios?', answer: 'Yes! Use the ratio preset buttons — Free, Square 1:1, 4:3, or Wide 16:9. When a ratio is locked, dragging any handle automatically maintains that proportion. Switch back to "Free" mode for unrestricted cropping.' },
          { question: 'Does cropping affect image quality?', answer: 'No — cropping simply selects a portion of your image. The cropped area retains the original resolution and quality of that region. There is no re-encoding or quality loss from the crop operation itself.' },
          { question: 'Can I crop and then apply other tools?', answer: 'Absolutely. After cropping, switch to any other tab — Resize, Compress, Convert, Filters, or Rotate — and the cropped result becomes the source for further processing. All tools chain together seamlessly.' },
        ]} />
      </div>
    </div>
  </section>
</BaseLayout>
