---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await render(post);
const slug = post.id.replace(/\.md$/, '');
const canonical = new URL(`/blog/${slug}/`, SITE.url).href;
const wordCount = post.body?.split(/\s+/).length || 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
const category = post.data.category || 'General';
const categoryColors: Record<string, string> = {
  Compression: 'bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-400',
  Conversion: 'bg-purple-100 text-purple-700 dark:bg-purple-900/40 dark:text-purple-400',
  Design:    'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-400',
  General:   'bg-accent-soft text-accent',
};

// JSON-LD Article structured data
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
};
const jsonLd = JSON.stringify(articleSchema);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <Fragment set:html={`<script type="application/ld+json">${jsonLd}</script>`} />
  <SchemaOrg type="BreadcrumbList" data={{ items: [
    { name: 'Home', item: new URL('/', Astro.url).href },
    { name: 'Blog', item: new URL('/blog', Astro.url).href },
    { name: post.data.title, item: canonical },
  ] }} />

  <!-- ==========================================
       ARTICLE HERO — category badge, date, reading time, title, subtitle
       ========================================== -->
  <section class="relative overflow-hidden border-b border-border-secondary bg-surface-primary pt-28 sm:pt-32">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-accent-soft/40 via-transparent to-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-4 pb-12 sm:px-6 sm:pb-16 lg:px-8">
      <!-- Back link -->
      <a href="/blog/" class="inline-flex items-center gap-1.5 text-sm font-medium text-text-secondary transition-colors duration-200 hover:text-accent mb-8">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        All articles
      </a>

      <!-- Meta row: category badge + reading time -->
      <div class="mb-5 flex flex-wrap items-center gap-3">
        <span class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ${categoryColors[category] || categoryColors.General}`}>
          {category}
        </span>
        <span class="text-xs text-text-tertiary">{readingTime} min read</span>
      </div>

      <!-- Title -->
      <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-text-primary sm:text-5xl lg:text-6xl">
        {post.data.title}
      </h1>

      <!-- Description / subtitle -->
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-text-secondary">
        {post.data.description}
      </p>

      <!-- Date row -->
      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-text-tertiary">
        <time datetime={post.data.pubDate.toISOString()}>
          Published {post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric', month: 'long', day: 'numeric',
          })}
        </time>
        {post.data.updatedDate && post.data.updatedDate > post.data.pubDate && (
          <time datetime={post.data.updatedDate.toISOString()}>
            &middot; Updated {post.data.updatedDate.toLocaleDateString('en-US', {
              year: 'numeric', month: 'long', day: 'numeric',
            })}
          </time>
        )}
      </div>
    </div>
  </section>

  <!-- ==========================================
       ARTICLE BODY — Medium/Substack-grade typography
       ========================================== -->
  <section class="bg-surface-secondary">
    <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
      <article class="rounded-2xl border border-border-secondary bg-surface-card p-6 shadow-sm sm:p-10 lg:p-14">

        <div class="
          prose prose-lg max-w-none dark:prose-invert
          /* ── Headings ── */
          prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-text-primary
          prose-h2:mt-12 prose-h2:mb-5 prose-h2:text-2xl prose-h2:border-b prose-h2:border-border-secondary prose-h2:pb-3
          prose-h3:mt-10 prose-h3:mb-4 prose-h3:text-xl
          /* ── Paragraphs ── */
          prose-p:text-text-secondary prose-p:leading-relaxed prose-p:my-5 prose-p:text-[1.0625rem]
          /* ── Links ── */
          prose-a:text-accent prose-a:font-medium prose-a:no-underline prose-a:border-b prose-a:border-accent/30 hover:prose-a:border-accent hover:prose-a:text-accent-hover
          /* ── Strong / Bold ── */
          prose-strong:text-text-primary prose-strong:font-semibold
          /* ── Inline code ── */
          prose-code:rounded-md prose-code:bg-surface-secondary prose-code:px-1.5 prose-code:py-0.5 prose-code:text-accent prose-code:text-[0.875em] prose-code:font-normal prose-code:before:content-none prose-code:after:content-none
          /* ── Code blocks ── */
          prose-pre:rounded-xl prose-pre:border prose-pre:border-border-secondary prose-pre:shadow-sm prose-pre:!bg-[#0d1117] prose-pre:text-[#c9d1d9]
          /* ── Lists ── */
          prose-li:text-text-secondary prose-li:my-1 prose-ul:my-5 prose-ol:my-5
          /* ── Blockquotes ── */
          prose-blockquote:border-l-[3px] prose-blockquote:border-l-accent prose-blockquote:bg-accent-soft/15 prose-blockquote:rounded-r-xl prose-blockquote:py-3 prose-blockquote:px-5 prose-blockquote:text-text-secondary prose-blockquote:not-italic prose-blockquote:my-6
          /* ── Tables ── */
          prose-table:w-full prose-table:overflow-hidden prose-table:rounded-xl prose-table:border prose-table:border-border-secondary prose-table:text-sm
          prose-th:bg-surface-secondary prose-th:text-text-primary prose-th:font-semibold prose-th:text-xs prose-th:px-4 prose-th:py-3 prose-th:border prose-th:border-border-secondary prose-th:uppercase prose-th:tracking-wider
          prose-td:px-4 prose-td:py-3 prose-td:text-text-secondary prose-td:border prose-td:border-border-secondary
          /* ── Images ── */
          prose-img:rounded-xl prose-img:shadow-lg prose-img:my-8 prose-img:mx-auto
          /* ── Horizontal rule ── */
          prose-hr:border-border-secondary prose-hr:my-10
          /* ── Arbitrary fallbacks ── */
          [&_table]:w-full [&_table]:border-collapse [&_table]:overflow-hidden [&_table]:rounded-xl
          [&_th]:bg-surface-secondary [&_th]:px-4 [&_th]:py-3 [&_th]:text-xs [&_th]:font-semibold [&_th]:text-text-primary [&_th]:border [&_th]:border-border-secondary [&_th]:uppercase [&_th]:tracking-wider
          [&_td]:px-4 [&_td]:py-3 [&_td]:text-sm [&_td]:text-text-secondary [&_td]:border [&_td]:border-border-secondary
          [&_pre_code]:!bg-transparent [&_pre_code]:p-0 [&_pre_code]:text-sm
        ">
          <Content />
        </div>

        <!-- ==========================================
             SHARE ROW
             ========================================== -->
        <div class="mt-10 flex items-center gap-4 border-t border-border-secondary pt-8">
          <span class="text-sm font-medium text-text-secondary">Share this article:</span>
          <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(canonical)}`}
             target="_blank" rel="noopener"
             class="inline-flex items-center gap-1.5 rounded-lg border border-border-secondary px-3 py-1.5 text-xs font-medium text-text-secondary transition-all duration-200 hover:bg-surface-secondary hover:text-text-primary">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            Share
          </a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`}
             target="_blank" rel="noopener"
             class="inline-flex items-center gap-1.5 rounded-lg border border-border-secondary px-3 py-1.5 text-xs font-medium text-text-secondary transition-all duration-200 hover:bg-surface-secondary hover:text-text-primary">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            Share
          </a>
        </div>

        <!-- ==========================================
             CTA BOX — gradient, hover effects, three tools
             ========================================== -->
        <div class="mt-10 overflow-hidden rounded-2xl border border-accent/20 bg-gradient-to-br from-accent-soft/40 via-accent-soft/20 to-transparent p-6 sm:p-10 text-center">
          <div class="mx-auto max-w-lg">
            <span class="inline-flex items-center rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent ring-1 ring-inset ring-accent/20">
              Free Tools
            </span>
            <h3 class="mt-4 text-2xl font-bold text-text-primary sm:text-3xl">
              Ready to put this into practice?
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-text-secondary">
              All GetPictora tools run directly in your browser. No uploads, no sign-ups, completely free.
            </p>
          </div>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            <a href="/compress"
               class="group inline-flex items-center gap-2 rounded-xl bg-accent px-5 py-3 text-sm font-semibold text-white shadow-sm transition-all duration-300 hover:bg-accent-hover hover:shadow-md hover:-translate-y-0.5">
              <svg class="h-4 w-4 transition-transform duration-300 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
              Compress
            </a>
            <a href="/convert"
               class="group inline-flex items-center gap-2 rounded-xl border-2 border-border-secondary bg-surface-card px-5 py-3 text-sm font-semibold text-text-primary shadow-sm transition-all duration-300 hover:border-accent/40 hover:shadow-md hover:-translate-y-0.5">
              <svg class="h-4 w-4 text-text-secondary transition-transform duration-300 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
              Convert
            </a>
            <a href="/resize"
               class="group inline-flex items-center gap-2 rounded-xl border-2 border-border-secondary bg-surface-card px-5 py-3 text-sm font-semibold text-text-primary shadow-sm transition-all duration-300 hover:border-accent/40 hover:shadow-md hover:-translate-y-0.5">
              <svg class="h-4 w-4 text-text-secondary transition-transform duration-300 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
              Resize
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
