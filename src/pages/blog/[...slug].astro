---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await render(post);
const slug = post.id.replace(/\.md$/, '');
const canonical = new URL(`/blog/${slug}/`, SITE.url).href;
const wordCount = post.body?.split(/\s+/).length || 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// JSON-LD Article structured data
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
};
const jsonLd = JSON.stringify(articleSchema);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
>
  <!-- Article JSON-LD -->
  <Fragment set:html={`<script type="application/ld+json">${jsonLd}</script>`} />
  <SchemaOrg type="BreadcrumbList" data={{ items: [
    { name: 'Home', item: new URL('/', Astro.url).href },
    { name: 'Blog', item: new URL('/blog', Astro.url).href },
    { name: post.data.title, item: canonical },
  ] }} />

  <!-- Article Header -->
  <section class="relative overflow-hidden border-b border-border-secondary bg-surface-primary">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-accent-soft/30 via-transparent to-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <a href="/blog/" class="inline-flex items-center gap-1 text-sm font-medium text-text-secondary transition-colors duration-200 hover:text-accent mb-6">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Blog
      </a>

      <div class="mb-4 flex flex-wrap items-center gap-3">
        {post.data.keywords?.map((kw: string) => (
          <span class="rounded-lg bg-accent-soft px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-accent">
            {kw}
          </span>
        ))}
        <span class="text-xs text-text-tertiary">{readingTime} min read</span>
      </div>

      <h1 class="text-4xl font-extrabold tracking-tight text-text-primary sm:text-5xl lg:text-6xl">
        {post.data.title}
      </h1>

      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-text-tertiary">
        <time datetime={post.data.pubDate.toISOString()}>
          Published {post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric', month: 'long', day: 'numeric',
          })}
        </time>
        {post.data.updatedDate && post.data.updatedDate > post.data.pubDate && (
          <time datetime={post.data.updatedDate.toISOString()}>
            &middot; Updated {post.data.updatedDate.toLocaleDateString('en-US', {
              year: 'numeric', month: 'long', day: 'numeric',
            })}
          </time>
        )}
      </div>
    </div>
  </section>

  <!-- Article Body -->
  <section class="bg-surface-secondary">
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
      <article class="rounded-2xl border border-border-secondary bg-surface-card p-8 shadow-sm sm:p-10 lg:p-12">
        <div class="prose prose-lg max-w-none dark:prose-invert
          prose-headings:text-text-primary prose-headings:font-bold prose-headings:tracking-tight
          prose-h2:mt-10 prose-h2:mb-4 prose-h2:text-2xl prose-h2:border-b prose-h2:border-border-secondary prose-h2:pb-2
          prose-h3:mt-8 prose-h3:mb-3 prose-h3:text-xl
          prose-p:text-text-secondary prose-p:leading-relaxed prose-p:my-4
          prose-a:text-accent prose-a:no-underline hover:prose-a:underline
          prose-strong:text-text-primary prose-strong:font-semibold
          prose-code:rounded-md prose-code:bg-surface-secondary prose-code:px-1.5 prose-code:py-0.5 prose-code:text-accent prose-code:text-sm prose-code:font-normal prose-code:before:content-none prose-code:after:content-none
          prose-pre:rounded-xl prose-pre:bg-surface-secondary prose-pre:border prose-pre:border-border-secondary prose-pre:shadow-sm
          prose-pre:!bg-surface-secondary prose-pre:text-text-secondary
          prose-li:text-text-secondary prose-li:my-1
          prose-ul:my-4 prose-ol:my-4
          prose-blockquote:border-l-accent prose-blockquote:bg-accent-soft/20 prose-blockquote:rounded-r-lg prose-blockquote:py-1 prose-blockquote:px-4 prose-blockquote:text-text-secondary prose-blockquote:not-italic
          prose-table:w-full prose-table:overflow-hidden prose-table:rounded-lg prose-table:border prose-table:border-border-secondary
          prose-th:bg-surface-secondary prose-th:text-text-primary prose-th:font-semibold prose-th:text-sm prose-th:px-4 prose-th:py-3 prose-th:border prose-th:border-border-secondary
          prose-td:px-4 prose-td:py-3 prose-td:text-sm prose-td:text-text-secondary prose-td:border prose-td:border-border-secondary
          prose-img:rounded-xl prose-img:shadow-md prose-img:my-6
          prose-hr:border-border-secondary
          [&_table]:w-full [&_table]:border-collapse [&_table]:rounded-lg [&_table]:overflow-hidden
          [&_th]:bg-surface-secondary [&_th]:px-4 [&_th]:py-3 [&_th]:text-sm [&_th]:font-semibold [&_th]:text-text-primary [&_th]:border [&_th]:border-border-secondary
          [&_td]:px-4 [&_td]:py-3 [&_td]:text-sm [&_td]:text-text-secondary [&_td]:border [&_td]:border-border-secondary
          [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_pre_code]:text-sm
          ">
          <Content />
        </div>

        <!-- CTA Box -->
        <div class="mt-12 rounded-2xl border border-accent/20 bg-accent-soft/30 p-6 sm:p-8 text-center">
          <p class="text-lg font-semibold text-text-primary">Ready to optimize your images?</p>
          <p class="mt-2 text-sm text-text-secondary">
            Try GetPictora&rsquo;s free browser-based tools &mdash; no uploads, 100% private.
          </p>
          <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
            <a href="/compress" class="inline-flex items-center gap-1.5 rounded-xl bg-accent px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:bg-accent-hover hover:shadow-md">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
              Compress Images
            </a>
            <a href="/convert" class="inline-flex items-center gap-1.5 rounded-xl border border-border-secondary px-5 py-2.5 text-sm font-semibold text-text-secondary transition-all duration-200 hover:bg-surface-secondary hover:text-text-primary">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
              Convert Formats
            </a>
            <a href="/resize" class="inline-flex items-center gap-1.5 rounded-xl border border-border-secondary px-5 py-2.5 text-sm font-semibold text-text-secondary transition-all duration-200 hover:bg-surface-secondary hover:text-text-primary">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
              Resize Images
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
