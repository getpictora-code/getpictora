---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageTools from '../components/ImageTools.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import SchemaOrg from '../components/SchemaOrg.astro';

const pageTitle = 'Resize Images Online — Free & Instant';
const pageDesc = 'Resize images online for free. Change image dimensions in pixels while maintaining quality. No uploads, 100% private, instant results. Works with JPG, PNG, WebP, GIF, BMP, and TIFF.';
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <SchemaOrg type="SoftwareApplication" data={{ name: 'Image Resizer', description: pageDesc, features: ['Pixel-perfect resizing','Aspect ratio lock','Percentage presets','Batch processing','Lossless quality'] }} />
  <SchemaOrg type="BreadcrumbList" data={{ items: [{ name: 'Home', item: new URL('/', Astro.url).href }, { name: 'Resize', item: new URL('/resize', Astro.url).href }] }} />
  <section class="relative overflow-hidden border-b border-border-secondary bg-surface-primary">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-accent-soft/30 via-transparent to-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Resize Tool</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-text-primary sm:text-5xl lg:text-6xl">
        Resize images online — free &amp; instant
      </h1>
      <p class="mt-5 max-w-2xl mx-auto text-lg leading-relaxed text-text-secondary">
        Change the dimensions of any image in seconds. Enter exact pixels or use percentage presets. Your files never leave your browser.
      </p>
    </div>
  </section>
  <section class="bg-surface-secondary">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
      <ImageTools initialTool="resize" />
    </div>
  </section>
  <section class="bg-surface-primary">
    <div class="mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent text-center">FAQ</p>
      <h2 class="mt-3 text-center text-3xl font-extrabold tracking-tight text-text-primary sm:text-4xl">Frequently asked questions</h2>
      <div class="mt-10">
        <FAQAccordion items={[
          { question: 'How do I change image dimensions in pixels safely?', answer: 'Enter your desired width and height in pixels, or use the 50% and 75% quick preset buttons. With "Maintain aspect ratio" checked, changing one dimension automatically adjusts the other to prevent stretching. The Original button restores the full uploaded dimensions.' },
          { question: 'Will maintaining the aspect ratio prevent my image from stretching?', answer: 'Yes. When "Maintain aspect ratio" is checked, our tool automatically calculates the proportional height when you change the width (and vice versa). This ensures your image never looks squished or stretched — it stays perfectly proportioned.' },
          { question: 'Can I resize images without losing quality?', answer: 'Downsizing (making images smaller) preserves visual sharpness. Upscaling (making images larger than the original) may reduce clarity since new pixels must be interpolated. For best results, always start with the highest resolution source available and resize downward.' },
          { question: 'What image formats can I resize?', answer: 'Our resize tool supports JPG, PNG, WebP, GIF, BMP, and TIFF images. The tool preserves your original format — a PNG stays PNG after resizing. If you need to change formats, switch to the Convert tab.' },
        ]} />
      </div>
    </div>
  </section>
</BaseLayout>
