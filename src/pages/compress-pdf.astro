---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageTools from '../components/ImageTools.astro';
import SchemaOrg from '../components/SchemaOrg.astro';

const pageTitle = 'Compress PDF Files Online — Reduce PDF Size Free';
const pageDesc = 'Compress PDF files online for free. Reduce PDF file size by adjusting quality and resolution. All processing happens in your browser — no uploads, 100% private, instant results.';
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <SchemaOrg type="SoftwareApplication" data={{ name: 'PDF Compressor', description: pageDesc, features: ['Quality slider','Resolution scaling','Multi-page support','Instant preview','100% private'] }} />
  <SchemaOrg type="BreadcrumbList" data={{ items: [{ name: 'Home', item: new URL('/', Astro.url).href }, { name: 'Compress PDF', item: new URL('/compress-pdf', Astro.url).href }] }} />
  <section class="relative overflow-hidden border-b border-border-secondary bg-surface-primary">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-accent-soft/30 via-transparent to-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">PDF Compress Tool</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-text-primary sm:text-5xl lg:text-6xl">
        Compress PDF files online — free &amp; instant
      </h1>
      <p class="mt-5 max-w-2xl mx-auto text-lg leading-relaxed text-text-secondary">
        Reduce your PDF file size without losing readability. Adjust quality and resolution. All processing happens in your browser — zero uploads, 100% private.
      </p>
    </div>
  </section>
  <section class="bg-surface-secondary">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
      <ImageTools initialTool="pdfcompress" />
    </div>
  </section>
</BaseLayout>
