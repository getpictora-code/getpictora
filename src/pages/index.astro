---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import ImageConverter from '../components/ImageConverter.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
---

<BaseLayout
  title="Home"
  description="Free online image tools — resize, compress, convert, crop, rotate, and apply filters. All processing happens in your browser. No uploads, 100% private, lightning fast."
>
  <SchemaOrg type="BreadcrumbList" data={{ items: [{ name: 'Home', item: new URL('/', Astro.url).href }] }} />
  <!-- ==========================================
       HERO SECTION
       ========================================== -->
  <section
    class="relative overflow-hidden bg-surface-primary"
  >
    <!-- Subtle gradient background glow -->
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-accent-soft/40 via-transparent to-transparent"
      aria-hidden="true"
    ></div>

    <div
      class="relative mx-auto flex max-w-4xl flex-col items-center px-4 pb-20 pt-28 text-center sm:px-6 sm:pb-24 sm:pt-32 lg:px-8 lg:pb-28 lg:pt-40"
    >
      <!-- Premium badge -->
      <span
        class="inline-flex items-center gap-2 rounded-full border border-border-secondary bg-surface-card px-4 py-1.5 text-xs font-medium text-text-secondary shadow-xs animate-soft hover:border-accent/30"
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-40"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
        </span>
        Free &amp; private — no uploads required
      </span>

      <!-- Headline -->
      <h1
        class="mt-8 max-w-3xl text-5xl font-extrabold leading-tight tracking-tight text-text-primary sm:text-6xl lg:text-7xl"
      >
        Transform your images.
        <span class="text-accent">Instantly.</span>
      </h1>

      <!-- Subtitle -->
      <p
        class="mt-6 max-w-2xl text-lg leading-relaxed text-text-secondary sm:text-xl"
      >
        Convert, compress, and optimize images right in your browser.
        Zero uploads &middot; 100% private &middot; Lightning fast.
      </p>

      <!-- Trust badges -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        {
          [
            { icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z', label: 'Privacy-first' },
            { icon: 'M13 10V3L4 14h7v7l9-11h-7z', label: 'Lightning fast' },
            { icon: 'M5 13l4 4L19 7', label: '100% accurate' },
          ].map(({ icon, label }) => (
            <span
              class="inline-flex items-center gap-1.5 rounded-lg bg-surface-secondary px-3 py-1.5 text-xs font-medium text-text-secondary"
            >
              <svg class="h-3.5 w-3.5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
              </svg>
              {label}
            </span>
          ))
        }
      </div>

      <!-- CTA -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/tools"
          class="inline-flex items-center gap-2 rounded-xl bg-accent px-7 py-3.5 text-base font-semibold text-white shadow-sm animate-soft hover:bg-accent-hover hover:shadow-md hover:-translate-y-0.5"
        >
          Start converting
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ==========================================
       TOOL CARDS SECTION
       ========================================== -->
  <section class="bg-surface-secondary">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
      <!-- Section heading -->
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-accent">
          Popular tools
        </p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-text-primary sm:text-4xl">
          Start converting in seconds
        </h2>
        <p class="mt-4 text-lg text-text-secondary">
          No sign-ups. No uploads. Just fast, accurate conversions right in your browser.
        </p>
      </div>

      <!-- Cards grid -->
      <div
        class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
      >
        <ToolCard
          title="JPG to PDF Converter"
          description="Combine multiple JPG images into a single, high-quality PDF document. Perfect for portfolios, reports, and sharing."
          fromFormat="JPG"
          toFormat="PDF"
          href="/tools"
        />
        <ToolCard
          title="PNG to JPG Converter"
          description="Convert PNG images to compressed JPG format without losing quality. Ideal for web optimization and smaller file sizes."
          fromFormat="PNG"
          toFormat="JPG"
          href="/tools"
        />
        <ToolCard
          title="WebP to PNG Converter"
          description="Transform modern WebP images into universally compatible PNG files. Great for compatibility and editing workflows."
          fromFormat="WebP"
          toFormat="PNG"
          href="/tools"
        />
      </div>
    </div>
  </section>

  <!-- ==========================================
       DRAG & DROP UPLOAD ZONE
       ========================================== -->
  <section class="bg-surface-primary">
    <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-sm font-semibold uppercase tracking-widest text-accent">
          Try it now
        </p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-text-primary sm:text-4xl">
          Upload &amp; convert instantly
        </h2>
        <p class="mt-4 text-lg text-text-secondary">
          Drag any image below. Conversion happens entirely in your browser — zero uploads.
        </p>
      </div>
      <ImageConverter
        outputFormat="pdf"
        outputLabel="PDF"
      />
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-surface-secondary">
    <div class="mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent text-center">FAQ</p>
      <h2 class="mt-3 text-center text-3xl font-extrabold tracking-tight text-text-primary sm:text-4xl">
        Frequently asked questions
      </h2>
      <div class="mt-10">
        <FAQAccordion
          items={[
            { question: 'Is my data safe?', answer: 'Absolutely. All image processing happens directly in your browser using the Canvas API. Your files are never uploaded to any server — they stay on your device the entire time.' },
            { question: 'What image formats are supported?', answer: 'We support JPEG, PNG, WebP, GIF, BMP, and TIFF formats for input. Output formats include JPEG, PNG, PDF, and WebP depending on the tool you use.' },
            { question: 'Is there a file size limit?', answer: 'Since processing happens locally in your browser, there are no server-imposed file size limits. Very large images may take longer depending on your device\'s processing power.' },
            { question: 'Does compressing reduce image quality?', answer: 'You control the quality. Our compression tool lets you adjust the quality slider from 10% to 100%. You can preview the result before downloading to find the perfect balance between file size and quality.' },
            { question: 'Is this service really free?', answer: 'Yes — 100% free with no hidden costs, no premium tiers, and no watermarks. We believe basic image tools should be accessible to everyone.' },
            { question: 'Can I use these tools offline?', answer: 'Once the page loads, yes! All processing is client-side JavaScript. If you keep the browser tab open, you can continue using the tools even if your internet connection drops.' },
          ]}
          openFirst={0}
        />
      </div>
    </div>
  </section>
</BaseLayout>

