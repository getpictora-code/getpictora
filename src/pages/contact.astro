---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaOrg from '../components/SchemaOrg.astro';

const pageTitle = 'Contact';
const pageDesc = 'Get in touch with the GetPictora team. Questions, feedback, or partnership inquiries — reach us at getpictora@gmail.com.';
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <SchemaOrg type="BreadcrumbList" data={{ items: [{ name: 'Home', item: new URL('/', Astro.url).href }, { name: 'Contact', item: new URL('/contact', Astro.url).href }] }} />

  <section class="relative overflow-hidden border-b border-border-secondary bg-surface-primary">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-accent-soft/30 via-transparent to-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Contact Us</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-text-primary sm:text-5xl lg:text-6xl">Get in touch</h1>
      <p class="mt-5 max-w-2xl mx-auto text-lg leading-relaxed text-text-secondary">Have questions, feedback, or partnership ideas? We'd love to hear from you.</p>
    </div>
  </section>

  <section class="bg-surface-secondary">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8 space-y-12">
      <div class="rounded-2xl border border-border-secondary bg-surface-card p-8 shadow-sm">
        <h2 class="text-xl font-semibold text-text-primary">Send us a message</h2>
        <p class="mt-2 text-sm text-text-secondary">We typically respond within 24 hours.</p>

        <div id="form-success" class="hidden mt-6 rounded-xl border border-green-200 bg-green-50 p-6 text-center">
          <svg class="mx-auto h-10 w-10 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <h3 class="mt-3 text-lg font-semibold text-green-800">Thank you!</h3>
          <p class="mt-1 text-sm text-green-700">Your message has been sent successfully. We'll get back to you within 24 hours.</p>
        </div>

        <div id="form-error" class="hidden mt-6 rounded-xl border border-red-200 bg-red-50 p-6 text-center">
          <h3 class="text-lg font-semibold text-red-800">Oops!</h3>
          <p class="mt-1 text-sm text-red-700">Something went wrong. Please try again or email us directly at getpictora@gmail.com.</p>
        </div>

        <!--
          WEB3FORMS SETUP:
          1. Go to https://web3forms.com
          2. Click "Get Access Key" (free, 250 msgs/month)
          3. Enter your email, verify, copy the key
          4. Replace YOUR_ACCESS_KEY_HERE below
        -->
        <form id="contact-form" class="mt-6 space-y-4" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
          <input type="hidden" name="subject" value="New Contact Form Message" />
          <input type="hidden" name="from_name" value="GetPictora Contact Form" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <div>
            <label for="contact-name" class="block text-xs font-semibold text-text-secondary mb-1.5">Name</label>
            <input id="contact-name" name="name" type="text" required placeholder="Your name" class="w-full rounded-xl border border-border-primary bg-surface-primary px-4 py-2.5 text-sm text-text-primary placeholder:text-text-tertiary focus:border-accent focus:ring-1 focus:ring-accent outline-none transition" />
          </div>
          <div>
            <label for="contact-email" class="block text-xs font-semibold text-text-secondary mb-1.5">Email</label>
            <input id="contact-email" name="email" type="email" required placeholder="you@example.com" class="w-full rounded-xl border border-border-primary bg-surface-primary px-4 py-2.5 text-sm text-text-primary placeholder:text-text-tertiary focus:border-accent focus:ring-1 focus:ring-accent outline-none transition" />
          </div>
          <div>
            <label for="contact-subject" class="block text-xs font-semibold text-text-secondary mb-1.5">Subject</label>
            <input id="contact-subject" name="topic" type="text" required placeholder="What's this about?" class="w-full rounded-xl border border-border-primary bg-surface-primary px-4 py-2.5 text-sm text-text-primary placeholder:text-text-tertiary focus:border-accent focus:ring-1 focus:ring-accent outline-none transition" />
          </div>
          <div>
            <label for="contact-message" class="block text-xs font-semibold text-text-secondary mb-1.5">Message</label>
            <textarea id="contact-message" name="message" rows="4" required placeholder="Tell us more..." class="w-full rounded-xl border border-border-primary bg-surface-primary px-4 py-2.5 text-sm text-text-primary placeholder:text-text-tertiary focus:border-accent focus:ring-1 focus:ring-accent outline-none transition resize-y"></textarea>
          </div>
          <button type="submit" id="form-submit-btn" class="inline-flex items-center gap-2 rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-white shadow-sm animate-soft hover:bg-accent-hover hover:shadow-md disabled:opacity-50 disabled:cursor-not-allowed">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span id="form-btn-text">Send Message</span>
            <span id="form-btn-spinner" class="hidden">
              <svg class="h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
            </span>
          </button>
        </form>
      </div>

      <div class="rounded-2xl border border-border-secondary bg-surface-card p-8 shadow-sm text-center">
        <h2 class="text-xl font-semibold text-text-primary">Prefer email?</h2>
        <p class="mt-2 text-sm text-text-secondary">Reach us directly at</p>
        <a href="mailto:getpictora@gmail.com" class="mt-3 inline-flex items-center gap-2 text-lg font-semibold text-accent animate-soft hover:text-accent-hover">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          getpictora@gmail.com
        </a>
      </div>
    </div>
  </section>

  <script>
    var form = document.getElementById('contact-form');
    var success = document.getElementById('form-success');
    var err = document.getElementById('form-error');
    var btn = document.getElementById('form-submit-btn');
    var btnText = document.getElementById('form-btn-text');
    var spinner = document.getElementById('form-btn-spinner');

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        btn.disabled = true;
        btnText.classList.add('hidden');
        spinner.classList.remove('hidden');
        success.classList.add('hidden');
        err.classList.add('hidden');

        fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (data.success) {
              form.reset();
              success.classList.remove('hidden');
              success.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } else {
              throw new Error(data.message || 'Submission failed');
            }
          })
          .catch(function() {
            err.classList.remove('hidden');
            err.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          })
          .finally(function() {
            btn.disabled = false;
            btnText.classList.remove('hidden');
            spinner.classList.add('hidden');
          });
      });
    }
  </script>
</BaseLayout>
