---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageTools from '../components/ImageTools.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import SchemaOrg from '../components/SchemaOrg.astro';

const pageTitle = 'Apply Image Filters Online — Free Photo Filter Tool';
const pageDesc = 'Apply filters to images online for free. Grayscale, sepia, invert, brighten, darken — all in your browser. No uploads, 100% private, instant preview.';
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <SchemaOrg type="SoftwareApplication" data={{ name: 'Image Filter Applier', description: pageDesc, features: ['6 professional filters','Grayscale & sepia','Brightness control','Pixel-level processing','Instant preview','Batch support'] }} />
  <SchemaOrg type="BreadcrumbList" data={{ items: [{ name: 'Home', item: new URL('/', Astro.url).href }, { name: 'Filters', item: new URL('/filters', Astro.url).href }] }} />
  <section class="relative overflow-hidden border-b border-border-secondary bg-surface-primary">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-accent-soft/30 via-transparent to-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Filters Tool</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-text-primary sm:text-5xl lg:text-6xl">
        Apply image filters — transform your photos
      </h1>
      <p class="mt-5 max-w-2xl mx-auto text-lg leading-relaxed text-text-secondary">
        Grayscale, sepia, invert, brighten, or darken — choose from 6 professional filters. Instant preview, pixel-level processing, 100% private.
      </p>
    </div>
  </section>
  <section class="bg-surface-secondary">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
      <ImageTools initialTool="filters" />
    </div>
  </section>
  <section class="bg-surface-primary">
    <div class="mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent text-center">FAQ</p>
      <h2 class="mt-3 text-center text-3xl font-extrabold tracking-tight text-text-primary sm:text-4xl">Frequently asked questions</h2>
      <div class="mt-10">
        <FAQAccordion items={[
          { question: 'Can I apply multiple filters to one image?', answer: 'Yes! Each filter operates on the current image state. Apply Grayscale, then switch to Compress to reduce the file size of the grayscale version. The chained pipeline remembers each transformation so you can build complex edits step by step.' },
          { question: 'How do I remove a filter after applying it?', answer: 'Click the "Reset" button in the Filters panel. This clears all active filters and restores your image to its previous state. You can also click "Reset" to clear ALL accumulated changes if needed.' },
          { question: 'Do filters affect the original image quality?', answer: 'Filters apply pixel-level transformations that permanently change the image data. However, since processing happens locally in your browser, your original file on disk is never modified — only the processed copy is affected.' },
        ]} />
      </div>
    </div>
  </section>
</BaseLayout>
