---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist. Return to GetPictora's free image tools.">
  <section class="relative overflow-hidden bg-surface-primary">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-accent-soft/30 via-transparent to-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto flex max-w-2xl flex-col items-center px-4 py-32 text-center sm:px-6 lg:px-8">
      <p class="text-8xl font-extrabold tracking-tight text-accent/20 sm:text-9xl">404</p>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-text-primary sm:text-5xl">
        Page not found
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-text-secondary max-w-md">
        The page you're looking for doesn't exist or has been moved. Let's get you back to converting images.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-white shadow-sm animate-soft hover:bg-accent-hover hover:shadow-md"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1"/></svg>
          Return to Home
        </a>
        <a
          href="/tools"
          class="inline-flex items-center gap-2 rounded-xl border border-border-primary px-6 py-3 text-sm font-semibold text-text-primary animate-soft hover:bg-surface-secondary"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          Browse Tools
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
