---
import { SITE } from '../../consts';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
}

const { title, description, ogImage, canonicalURL: canonicalURLProp } = Astro.props;

const pageTitle = title
  ? `${title} | ${SITE.name}`
  : `${SITE.name} — ${SITE.tagline}`;

const metaDescription = description ?? SITE.description;
const metaImage = ogImage ?? SITE.ogImage;
const canonicalHref = canonicalURLProp ?? Astro.url;
const resolvedOgImage = new URL(metaImage, SITE.url).href;
---

<!-- Primary Meta -->
<title>{pageTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonicalHref} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalHref} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:site_name" content={SITE.name} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={resolvedOgImage} />
