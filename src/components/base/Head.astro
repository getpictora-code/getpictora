---
import { SITE } from '../../consts';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
}

const { title, description, ogImage, canonicalURL: canonicalURLProp } = Astro.props;

const pageTitle = title
  ? `${title} | ${SITE.name}`
  : `${SITE.name} — ${SITE.tagline}`;

const metaDescription = description ?? SITE.description;
const metaImage = ogImage ?? SITE.ogImage;
const canonicalHref = canonicalURLProp ?? Astro.url;
const resolvedOgImage = new URL(metaImage, SITE.url).href;
---

<!-- Primary Meta -->
<title>{pageTitle}</title>
<meta name="description" content={metaDescription} />
<meta name="keywords" content="image converter, image resizer, compress png, compress jpeg, batch image processing, online image crop, getpictora, free image tools, browser image editor, compress pdf, pdf compressor, jpg to pdf, png to jpg, webp to png" />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonicalHref} />

<!-- Google Search Console Verification — replace with your verification code -->
<meta name="google-site-verification" content="GOOGLE-SEARCH-CONSOLE-CODE" />

<!-- Monetag Verification -->
<meta name="monetag" content="6f1dd9acf606a63a263d3451093baf8c" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalHref} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="en_US" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitter} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={resolvedOgImage} />
