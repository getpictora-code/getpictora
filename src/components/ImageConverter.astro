---
export interface Props {
  /** Accepted MIME types, e.g. ["image/jpeg", "image/png"] */
  acceptFormats?: string[];
  /** Target output format */
  outputFormat: 'pdf' | 'jpeg' | 'png';
  /** Human-readable label for the output */
  outputLabel: string;
  /** Max file size in MB (default 50) */
  maxFileSizeMB?: number;
  /** Whether to allow multiple files */
  multiple?: boolean;
}

const {
  acceptFormats = ['image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/bmp', 'image/tiff'],
  outputFormat,
  outputLabel,
  maxFileSizeMB = 50,
  multiple = true,
} = Astro.props;

const acceptAttr = acceptFormats.join(',');
const maxBytes = maxFileSizeMB * 1024 * 1024;

// Format badge labels for display
const formatLabels = acceptFormats
  .map((f) => f.replace('image/', '').toUpperCase())
  .join(', ');
---

<div
  id="image-converter-{outputFormat}"
  class="w-full"
  data-output-format={outputFormat}
  data-output-label={outputLabel}
  data-max-bytes={String(maxBytes)}
  data-multiple={String(multiple)}
  data-accept-formats={JSON.stringify(acceptFormats)}
>
  <!-- ==========================================
       IDLE STATE: Drop Zone
       ========================================== -->
  <div id="drop-zone-{outputFormat}" class="group relative">
    <label
      for="file-input-{outputFormat}"
      class="flex cursor-pointer flex-col items-center gap-4 rounded-3xl border-2 border-dashed border-border-primary bg-surface-card px-8 py-16 text-center shadow-sm transition-all duration-300 hover:border-accent/40 hover:bg-accent-soft/20 hover:shadow-md"
    >
      <!-- Upload icon -->
      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-accent-soft text-accent transition-transform duration-300 group-hover:scale-110">
        <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
        </svg>
      </div>

      <div>
        <p class="text-lg font-semibold text-text-primary">
          Drag &amp; drop your images here
        </p>
        <p class="mt-1 text-sm text-text-secondary">
          or click to browse files
        </p>
      </div>

      <span class="inline-flex items-center gap-2 rounded-xl bg-accent px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-300 hover:bg-accent-hover hover:shadow-md">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
        </svg>
        Browse Files
      </span>

      <p class="text-xs text-text-tertiary">
        Accepted formats: {formatLabels} &middot; Max {maxFileSizeMB}MB per file
      </p>

      <input
        id="file-input-{outputFormat}"
        type="file"
        class="hidden"
        accept={acceptAttr}
        multiple={multiple}
      />
    </label>
  </div>

  <!-- ==========================================
       PROCESSING STATE: Preview + Progress
       ========================================== -->
  <div id="preview-area-{outputFormat}" class="hidden space-y-4">
    <!-- Header with count -->
    <div class="flex items-center justify-between">
      <span id="file-count-{outputFormat}" class="text-sm font-medium text-text-secondary"></span>
      <button
        id="clear-btn-{outputFormat}"
        class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-medium text-text-secondary animate-soft hover:bg-surface-secondary hover:text-text-primary"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        Clear all
      </button>
    </div>

    <!-- File list -->
    <div id="file-list-{outputFormat}" class="space-y-3"></div>
  </div>

  <!-- Template for a single file item (cloned by JS) -->
  <template id="file-item-template-{outputFormat}">
    <div class="file-item flex items-center gap-4 rounded-2xl border border-border-secondary bg-surface-card p-4 shadow-sm animate-soft">
      <div class="file-thumb h-14 w-14 flex-shrink-0 overflow-hidden rounded-xl bg-surface-secondary">
        <img src="" alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
      </div>
      <div class="flex-1 min-w-0">
        <p class="file-name text-sm font-medium text-text-primary truncate"></p>
        <p class="file-size text-xs text-text-tertiary mt-0.5"></p>
      </div>
      <div class="file-status flex flex-shrink-0 items-center gap-2">
        <span class="file-spinner" style="display:none">
          <svg class="h-5 w-5 animate-spin text-accent" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
        </span>
        <span class="file-done" style="display:none; color:var(--tw-accent)">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </span>
        <span class="file-error" style="display:none; color:#ef4444; font-size:12px; font-weight:500"></span>
      </div>
      <button class="file-download flex-shrink-0 rounded-xl bg-accent px-4 py-2 text-xs font-semibold text-white animate-soft hover:bg-accent-hover" style="display:none">
        Download
      </button>
    </div>
  </template>

  <!-- Toast notification container -->
  <div id="toast" style="display:none; position:fixed; bottom:20px; right:20px; padding:12px 16px; border-radius:10px; font-size:14px; font-weight:500; box-shadow:0 10px 25px rgba(0,0,0,0.15); z-index:9999; pointer-events:none; transition:opacity 0.3s, transform 0.3s;"></div>
</div>

<script>
  // Dynamically import jsPDF only when PDF conversion is needed (saves ~200KB)
  let jsPDFModule: typeof import('jspdf') | null = null;
  async function getJsPDF() {
    if (!jsPDFModule) {
      const mod = await import('jspdf');
      jsPDFModule = mod;
    }
    return jsPDFModule;
  }

  function initConverter(container: HTMLElement) {
    const format = container.dataset.outputFormat!;
    const label = container.dataset.outputLabel!;
    const maxBytes = parseInt(container.dataset.maxBytes!);
    const isMultiple = container.dataset.multiple === 'true';
    const acceptFormats: string[] = JSON.parse(container.dataset.acceptFormats!);

    const dropZone = container.querySelector<HTMLElement>(`[id^="drop-zone-"]`)!;
    const fileInput = container.querySelector<HTMLInputElement>(`[id^="file-input-"]`)!;
    const previewArea = container.querySelector<HTMLElement>(`[id^="preview-area-"]`)!;
    const fileList = container.querySelector<HTMLElement>(`[id^="file-list-"]`)!;
    const fileCount = container.querySelector<HTMLElement>(`[id^="file-count-"]`)!;
    const clearBtn = container.querySelector<HTMLElement>(`[id^="clear-btn-"]`)!;
    const template = container.querySelector<HTMLTemplateElement>(`[id^="file-item-template-"]`)!;

    // Drag & drop handlers
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.querySelector('label')!.classList.add('border-accent', 'bg-accent-soft/40');
    });
    dropZone.addEventListener('dragleave', () => {
      dropZone.querySelector('label')!.classList.remove('border-accent', 'bg-accent-soft/40');
    });
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.querySelector('label')!.classList.remove('border-accent', 'bg-accent-soft/40');
      const files = Array.from(e.dataTransfer?.files ?? []);
      handleFiles(files);
    });

    fileInput.addEventListener('change', () => {
      const files = Array.from(fileInput.files ?? []);
      handleFiles(files);
      fileInput.value = '';
    });

    clearBtn.addEventListener('click', () => {
      fileList.innerHTML = '';
      dropZone.classList.remove('hidden');
      previewArea.classList.add('hidden');
    });

    function handleFiles(files: File[]) {
      const validFiles = files.filter((f) => {
        if (!acceptFormats.includes(f.type)) {
          showToast(`"${f.name}" is not a supported format.`, 'error');
          return false;
        }
        if (f.size > maxBytes) {
          showToast(`"${f.name}" exceeds ${Math.round(maxBytes / 1024 / 1024)}MB limit.`, 'error');
          return false;
        }
        return true;
      });

      if (validFiles.length === 0) return;

      dropZone.classList.add('hidden');
      previewArea.classList.remove('hidden');
      fileCount.textContent = `${validFiles.length} file${validFiles.length !== 1 ? 's' : ''} selected`;

      validFiles.forEach((file) => processFile(file));
    }

    async function processFile(file: File) {
      const clone = template.content.cloneNode(true) as HTMLElement;
      const item = clone.querySelector<HTMLElement>('.file-item')!;
      const thumb = clone.querySelector<HTMLImageElement>('.file-thumb img')!;
      const nameEl = clone.querySelector<HTMLElement>('.file-name')!;
      const sizeEl = clone.querySelector<HTMLElement>('.file-size')!;
      const spinner = clone.querySelector<HTMLElement>('.file-spinner')!;
      const done = clone.querySelector<HTMLElement>('.file-done')!;
      const errorEl = clone.querySelector<HTMLElement>('.file-error')!;
      const downloadBtn = clone.querySelector<HTMLButtonElement>('.file-download')!;

      nameEl.textContent = file.name;
      sizeEl.textContent = formatBytes(file.size);
      fileList.appendChild(clone);

      // Show thumbnail
      const reader = new FileReader();
      reader.onload = (e) => {
        thumb.src = e.target?.result as string;
      };
      reader.readAsDataURL(file);

      try {
        spinner.style.display = '';

        const outputFile = await convertImage(file, format, label);

        spinner.style.display = 'none';
        done.style.display = '';
        downloadBtn.style.display = '';

        downloadBtn.addEventListener('click', () => {
          const url = URL.createObjectURL(outputFile);
          const a = document.createElement('a');
          a.href = url;
          a.download = outputFile.name;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(() => URL.revokeObjectURL(url), 10000);
        });
      } catch (err: any) {
        spinner.style.display = 'none';
        errorEl.style.display = '';
        errorEl.textContent = err.message || 'Conversion failed';
      }
    }

    async function convertImage(file: File, format: string, label: string): Promise<File> {
      const img = await loadImage(file);

      if (format === 'pdf') {
        return convertToPDF(img, file.name);
      }

      // Canvas-based conversion for JPEG/PNG
      const canvas = document.createElement('canvas');
      canvas.width = img.naturalWidth;
      canvas.height = img.naturalHeight;
      const ctx = canvas.getContext('2d')!;
      ctx.drawImage(img, 0, 0);

      const mimeType = format === 'jpeg' ? 'image/jpeg' : 'image/png';
      const ext = format === 'jpeg' ? 'jpg' : 'png';

      return new Promise((resolve, reject) => {
        canvas.toBlob(
          (blob) => {
            if (!blob) return reject(new Error('Canvas conversion failed'));
            const newName = file.name.replace(/\.[^.]+$/, `.${ext}`);
            resolve(new File([blob], newName, { type: mimeType }));
          },
          mimeType,
          0.92
        );
      });
    }

    async function convertToPDF(img: HTMLImageElement, originalName: string): Promise<File> {
      const { jsPDF } = await getJsPDF();
      const doc = new jsPDF({
        orientation: img.naturalWidth > img.naturalHeight ? 'landscape' : 'portrait',
        unit: 'px',
        format: [img.naturalWidth, img.naturalHeight],
      });
      doc.addImage(img, 'JPEG', 0, 0, img.naturalWidth, img.naturalHeight, undefined, 'FAST');
      const blob = doc.output('blob');
      const newName = originalName.replace(/\.[^.]+$/, '.pdf');
      return new File([blob], newName, { type: 'application/pdf' });
    }

    function loadImage(file: File): Promise<HTMLImageElement> {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => {
          const img = new Image();
          img.onload = () => resolve(img);
          img.onerror = () => reject(new Error('Failed to load image'));
          img.src = reader.result as string;
        };
        reader.onerror = () => reject(new Error('Failed to read file'));
        reader.readAsDataURL(file);
      });
    }
  }

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1048576).toFixed(2) + ' MB';
  }

  function showToast(msg: string, type: 'error' | 'info') {
    let toast = document.getElementById('toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'toast';
      Object.assign(toast.style, {
        display: 'none',
        position: 'fixed',
        bottom: '20px',
        right: '20px',
        padding: '12px 16px',
        borderRadius: '10px',
        fontSize: '14px',
        fontWeight: '500',
        boxShadow: '0 10px 25px rgba(0,0,0,0.15)',
        zIndex: '9999',
        pointerEvents: 'none',
        transition: 'opacity 0.3s, transform 0.3s',
      });
      document.body.appendChild(toast);
    }

    // Set colors based on type
    const isError = type === 'error';
    toast.style.background = isError ? '#ef4444' : 'var(--tw-accent, #007aff)';
    toast.style.color = '#ffffff';
    toast.textContent = msg;

    // Show: slide up + fade in
    toast.style.display = 'block';
    toast.style.opacity = '0';
    toast.style.transform = 'translateY(20px)';
    requestAnimationFrame(() => {
      toast.style.opacity = '1';
      toast.style.transform = 'translateY(0)';
    });

    // Hide after 3s
    setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transform = 'translateY(20px)';
      setTimeout(() => { toast.style.display = 'none'; }, 300);
    }, 3000);
  }

  // Auto-init all converter instances
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLElement>('[id^="image-converter-"]').forEach(initConverter);
  });
</script>
