---
// ImageTools.astro — Full interactive tool suite: Resize, Compress, Convert, Crop, Rotate, Filters
export interface Props {
  maxFileSizeMB?: number;
  /** Pre-select a specific tool on load: 'resize' | 'compress' | 'convert' | 'crop' | 'rotate' | 'filters' */
  initialTool?: string;
}

const maxFileSizeMB = Astro.props.maxFileSizeMB ?? 50;
const maxBytes = maxFileSizeMB * 1024 * 1024;
const initialTool = Astro.props.initialTool ?? 'resize';
---

<div id="image-tools-app" class="w-full" data-max-bytes={String(maxBytes)} data-initial-tool={initialTool}>
  <!-- ==========================================
       UPLOAD ZONE (Idle State)
       ========================================== -->
  <div id="tools-drop-zone" class="group relative">
    <label
      for="tools-file-input"
      class="flex cursor-pointer flex-col items-center gap-4 rounded-3xl border-2 border-dashed border-border-primary bg-surface-card px-4 py-12 sm:px-8 sm:py-16 text-center shadow-sm transition-all duration-300 hover:border-accent/40 hover:bg-accent-soft/20 hover:shadow-md will-change-transform"
    >
      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-accent-soft text-accent transition-transform duration-300 group-hover:scale-110">
        <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/></svg>
      </div>
      <div>
        <p class="text-lg font-semibold text-text-primary" id="drop-title">Drag &amp; drop your images here</p>
        <p class="mt-1 text-sm text-text-secondary" id="drop-subtitle">or click to browse — supports JPG, PNG, WebP, GIF, BMP, TIFF</p>
      </div>
      <span class="inline-flex items-center gap-2 rounded-xl bg-accent px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-300 hover:bg-accent-hover hover:shadow-md">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
        Browse Files
      </span>
      <p class="text-xs text-text-tertiary">Max {maxFileSizeMB}MB per file &middot; 100% private &middot; No uploads</p>
      <input id="tools-file-input" type="file" class="hidden" accept="image/jpeg,image/png,image/webp,image/gif,image/bmp,image/tiff,application/pdf" multiple />
    </label>
  </div>

  <!-- Trust badges row (shown in idle state) -->
  <div id="tools-trust-row" class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 text-[11px] leading-relaxed text-text-tertiary sm:text-xs sm:gap-x-6">
      <span class="inline-flex items-center gap-1.5 min-h-[44px] sm:min-h-0">🔒 100% Private (Local Processing)</span>
    <span class="hidden sm:inline text-text-tertiary/30">•</span>
    <span class="inline-flex items-center gap-1.5 min-h-[44px] sm:min-h-0">⚡ Zero Server Uploads</span>
    <span class="hidden sm:inline text-text-tertiary/30">•</span>
    <span class="inline-flex items-center gap-1.5 min-h-[44px] sm:min-h-0">🚫 No Registration</span>
  </div>

  <!-- ==========================================
       WORKSPACE (Active State)
       ========================================== -->
  <div id="tools-workspace" class="hidden space-y-6">
    <!-- Header bar -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span id="tools-file-count" class="text-sm font-medium text-text-secondary"></span>
        <button id="tools-clear-btn" class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-medium text-text-secondary animate-soft hover:bg-surface-secondary hover:text-text-primary">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          Clear all
        </button>
      </div>
      <button id="tools-download-all" class="inline-flex items-center gap-2 rounded-xl bg-accent px-5 py-2.5 text-sm font-semibold text-white shadow-sm animate-soft hover:bg-accent-hover hover:shadow-md">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
        Download All
      </button>
    </div>

    <!-- ==========================================
         TOOL SELECTOR TABS
         ========================================== -->
    <div role="tablist" aria-label="Image editing tools" class="flex flex-nowrap gap-1 rounded-2xl border border-border-secondary bg-surface-secondary p-1.5 overflow-x-auto">
      {[
        { id: 'resize', label: 'Resize' },
        { id: 'compress', label: 'Compress' },
        { id: 'convert', label: 'Convert' },
        { id: 'crop', label: 'Crop' },
        { id: 'rotate', label: 'Rotate' },
        { id: 'filters', label: 'Filters' },
        { id: 'pdfcompress', label: 'PDF Compress' },
      ].map((tool, i) => (
        <button
          role="tab"
          data-tool={tool.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={`${tool.label} tool`}
          tabindex={i === 0 ? 0 : -1}
          class={`tools-tab flex-shrink-0 min-w-[68px] sm:min-w-[80px] sm:flex-1 rounded-xl px-2.5 py-2.5 sm:px-3 text-[11px] sm:text-xs font-semibold whitespace-nowrap transition-all duration-200 focus-visible:outline-2 focus-visible:outline-accent ${
            i === 0 ? 'bg-surface-card text-text-primary shadow-sm' : 'text-text-secondary hover:text-text-primary hover:bg-surface-card/60'
          }`}
          data-active={i === 0 ? 'true' : 'false'}
        >
          {tool.label}
        </button>
      ))}
    </div>

    <!-- ==========================================
         TOOL PARAMETER PANELS
         ========================================== -->
    <div id="tools-panels" class="rounded-2xl border border-border-secondary bg-surface-card p-6 shadow-sm" style="min-height: 220px;">
      <!-- Resize Panel -->
      <div data-panel="resize" class="space-y-4">
        <div class="flex items-center gap-4 flex-wrap">
          <div class="flex-1 min-w-[120px]">
            <label class="block text-xs font-semibold text-text-secondary mb-1.5">Width (px)</label>
            <input type="number" id="resize-w" value="800" min="1" max="10000" class="w-full rounded-xl border border-border-primary bg-surface-primary px-4 py-2.5 text-sm text-text-primary focus:border-accent focus:ring-1 focus:ring-accent outline-none transition" />
          </div>
          <div class="flex-1 min-w-[120px]">
            <label class="block text-xs font-semibold text-text-secondary mb-1.5">Height (px)</label>
            <input type="number" id="resize-h" value="600" min="1" max="10000" class="w-full rounded-xl border border-border-primary bg-surface-primary px-4 py-2.5 text-sm text-text-primary focus:border-accent focus:ring-1 focus:ring-accent outline-none transition" />
          </div>
          <div class="flex items-end gap-2 pt-4">
            <button id="resize-preset-50" class="rounded-lg border border-border-secondary px-3 py-2 text-xs font-medium text-text-secondary animate-soft hover:bg-surface-secondary">50%</button>
            <button id="resize-preset-75" class="rounded-lg border border-border-secondary px-3 py-2 text-xs font-medium text-text-secondary animate-soft hover:bg-surface-secondary">75%</button>
            <button id="resize-preset-orig" class="rounded-lg border border-border-secondary px-3 py-2 text-xs font-medium text-text-secondary animate-soft hover:bg-surface-secondary">Original</button>
          </div>
        </div>
        <label class="flex items-center gap-2 text-sm text-text-secondary cursor-pointer">
          <input type="checkbox" id="resize-aspect" checked class="rounded accent-accent" /> Maintain aspect ratio
        </label>
      </div>

      <!-- Compress Panel -->
      <div data-panel="compress" class="hidden space-y-4">
        <div>
          <label class="block text-xs font-semibold text-text-secondary mb-1.5">Quality: <span id="compress-val">80</span>%</label>
          <input type="range" id="compress-slider" value="80" min="10" max="100" step="5" class="w-full accent-accent" />
        </div>
        <p class="text-xs text-text-tertiary">Lower quality = smaller file size. Preview updates live.</p>
      </div>

      <!-- Convert Panel -->
      <div data-panel="convert" class="hidden space-y-4">
        <div>
          <label class="block text-xs font-semibold text-text-secondary mb-1.5">Output Format</label>
          <select id="convert-format" class="w-full rounded-xl border border-border-primary bg-surface-primary px-4 py-2.5 text-sm text-text-primary focus:border-accent focus:ring-1 focus:ring-accent outline-none transition">
            <optgroup label="Images">
              <option value="image/jpeg">JPEG (best for photos)</option>
              <option value="image/png">PNG (lossless, transparency)</option>
              <option value="image/webp">WebP (modern, smaller)</option>
              <option value="image/svg+xml">SVG (vector graphics)</option>
            </optgroup>
            <optgroup label="Documents">
              <option value="application/pdf">PDF Document (.pdf)</option>
              <option value="application/vnd.openxmlformats-officedocument.wordprocessingml.document">Word Document (.docx)</option>
              <option value="application/vnd.openxmlformats-officedocument.presentationml.presentation">PowerPoint (.pptx)</option>
              <option value="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">Excel Spreadsheet (.xlsx)</option>
            </optgroup>
            <optgroup label="Web">
              <option value="text/html">Web Page (.html)</option>
            </optgroup>
          </select>
        </div>
        <div id="convert-quality-wrap">
          <label class="block text-xs font-semibold text-text-secondary mb-1.5">Quality: <span id="convert-qval">90</span>%</label>
          <input type="range" id="convert-quality" value="90" min="10" max="100" step="5" class="w-full accent-accent" />
        </div>
      </div>

      <!-- Crop Panel -->
      <div data-panel="crop" class="hidden space-y-4">
        <!-- Aspect ratio presets -->
        <div class="flex flex-wrap gap-1.5">
          {[
            { id: 'free', label: 'Free' },
            { id: '1:1', label: 'Square 1:1' },
            { id: '4:3', label: '4:3' },
            { id: '16:9', label: 'Wide 16:9' },
          ].map(({ id, label }) => (
            <button data-crop-ratio={id} class={`crop-ratio-btn rounded-lg border px-3 py-1.5 text-[11px] font-medium animate-soft ${id === 'free' ? 'bg-accent-soft border-accent/30 text-accent' : 'border-border-secondary text-text-secondary hover:bg-surface-secondary hover:text-text-primary'}`}>
              {label}
            </button>
          ))}
        </div>

        <!-- Interactive crop canvas -->
        <div class="relative rounded-xl overflow-hidden border border-border-secondary bg-surface-primary select-none">
          <canvas id="crop-canvas" class="w-full cursor-crosshair touch-none block" style="min-height:280px;max-height:480px;"></canvas>
          <p id="crop-dim-label" class="absolute bottom-2 left-3 text-[10px] font-mono text-white bg-black/50 rounded-md px-2 py-1 pointer-events-none">—</p>
        </div>

        <!-- Hidden number inputs — synced from canvas, read by processFile -->
        <input type="hidden" id="crop-x" value="0" />
        <input type="hidden" id="crop-y" value="0" />
        <input type="hidden" id="crop-w" value="0" />
        <input type="hidden" id="crop-h" value="0" />

        <div class="flex flex-wrap items-center gap-2">
          <button id="crop-reset-btn" class="inline-flex items-center gap-1.5 rounded-lg border border-border-secondary px-3 py-2 text-xs font-medium text-text-secondary animate-soft hover:bg-surface-secondary hover:text-text-primary">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            Full Image
          </button>
          <span id="crop-info" class="text-[11px] text-text-tertiary">Drag handles to crop</span>
        </div>
      </div>

      <!-- Rotate Panel -->
      <div data-panel="rotate" class="hidden space-y-4">
        <div class="flex flex-wrap gap-2">
          {[
            { deg: 90, label: '90° Right', icon: 'M3 4h13M3 20h13M3 12h17' },
            { deg: 180, label: '180°', icon: 'M3 4h18M3 12h13M3 20h18' },
            { deg: 270, label: '90° Left', icon: 'M21 4H8m13 16H8m13-8H4' },
            { deg: 'custom', label: 'Custom', icon: 'M12 4v16m8-8H4' },
          ].map(({ deg, label, icon }) => (
            <button data-rotate={String(deg)} aria-label={label} class="rotate-btn flex items-center gap-2 rounded-xl border border-border-secondary px-4 py-3 text-sm font-medium text-text-secondary animate-soft hover:bg-surface-secondary hover:text-text-primary focus-visible:outline-2 focus-visible:outline-accent">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={icon}/></svg>
              {label}
            </button>
          ))}
        </div>
        <div data-rotate-custom class="hidden">
          <label class="block text-xs font-semibold text-text-secondary mb-1.5">Custom angle</label>
          <input type="number" id="rotate-custom-deg" value="45" min="-360" max="360" class="w-32 rounded-xl border border-border-primary bg-surface-primary px-4 py-2.5 text-sm text-text-primary focus:border-accent outline-none transition" />
        </div>
      </div>

      <!-- Filters Panel -->
      <div data-panel="filters" class="hidden space-y-4">
        <div class="flex flex-wrap gap-2">
          {[
            { id: 'grayscale', label: 'Grayscale', icon: 'M12 3v18m-9-9h18' },
            { id: 'sepia', label: 'Sepia', icon: 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z' },
            { id: 'invert', label: 'Invert', icon: 'M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z' },
            { id: 'brightness-up', label: 'Brighten', icon: 'M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z' },
            { id: 'brightness-down', label: 'Darken', icon: 'M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z' },
            { id: 'none', label: 'Reset', icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15' },
          ].map(({ id, label, icon }) => (
            <button data-filter={id} aria-label={label} class="filter-btn flex items-center gap-2 rounded-xl border border-border-secondary px-4 py-3 text-sm font-medium text-text-secondary animate-soft hover:bg-surface-secondary hover:text-text-primary focus-visible:outline-2 focus-visible:outline-accent">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={icon}/></svg>
              {label}
            </button>
          ))}
        </div>
      </div>

      <!-- PDF Compress Panel -->
      <div data-panel="pdfcompress" class="hidden space-y-4">
        <div>
          <label class="block text-xs font-semibold text-text-secondary mb-1.5">Quality: <span id="pdfcomp-qval">85</span>%</label>
          <input type="range" id="pdfcomp-quality" value="85" min="10" max="100" step="5" class="w-full accent-accent" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-text-secondary mb-1.5">Scale: <span id="pdfcomp-scaleval">0.85</span>x</label>
          <input type="range" id="pdfcomp-scale" value="85" min="30" max="100" step="5" class="w-full accent-accent" />
        </div>
        <p class="text-xs text-text-tertiary">Upload a PDF to compress. Lower quality = smaller file size. Scale reduces page resolution before re-packaging.</p>
      </div>
    </div>

    <!-- Preview area -->
    <div class="rounded-2xl border border-border-secondary bg-surface-card shadow-sm overflow-hidden">
      <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 border-b border-border-secondary">
        <h3 class="text-sm font-semibold text-text-primary">Processed Images</h3>
        <span id="tools-preview-count" class="text-xs text-text-tertiary"></span>
      </div>
      <div id="tools-preview-grid" class="p-4 space-y-3"></div>
    </div>
  </div>

  <!-- Template for premium preview card -->
  <template id="tools-preview-template">
    <div class="preview-card group rounded-xl border border-border-secondary bg-surface-secondary overflow-hidden animate-soft hover:shadow-md">
      <!-- Image row: before + arrow + after -->
      <div class="flex items-center gap-2 p-4">
        <!-- Before (original) -->
        <div class="flex-1 flex flex-col items-center min-w-0">
          <div class="relative w-full aspect-square rounded-lg overflow-hidden bg-surface-primary border border-border-secondary">
            <img src="" alt="" loading="lazy" decoding="async" class="preview-orig-img h-full w-full object-contain p-1" />
          </div>
          <span class="mt-1.5 text-[10px] font-medium text-text-tertiary uppercase tracking-wide">Original</span>
        </div>
        <!-- Arrow -->
        <svg class="h-5 w-5 flex-shrink-0 text-accent mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        <!-- After (processed) -->
        <div class="flex-1 flex flex-col items-center min-w-0">
          <div class="relative w-full aspect-square rounded-lg overflow-hidden bg-surface-primary border-2 border-accent/20 group-hover:border-accent/50 transition-colors">
            <canvas class="preview-canvas h-full w-full object-contain p-1"></canvas>
          </div>
          <span class="mt-1.5 text-[10px] font-semibold text-accent uppercase tracking-wide">Optimized</span>
        </div>
      </div>

      <!-- Metadata footer -->
      <div class="px-4 pb-4 space-y-2">
        <p class="preview-name text-xs font-medium text-text-primary truncate"></p>
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1 rounded-md bg-surface-primary border border-border-secondary px-2 py-1 text-[10px] font-medium text-text-tertiary">
            <span class="preview-orig-size"></span>
          </span>
          <svg class="h-3 w-3 text-text-tertiary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          <span class="inline-flex items-center gap-1 rounded-md bg-accent-soft border border-accent/20 px-2 py-1 text-[10px] font-semibold text-accent">
            <span class="preview-new-size"></span>
          </span>
          <span class="preview-savings hidden inline-flex items-center rounded-md bg-green-100 border border-green-200 px-2 py-1 text-[10px] font-bold text-green-700">
          </span>
        </div>
        <!-- Auto-processing button: Processing → Ready -->
        <button class="preview-download w-full rounded-lg px-3 py-2 text-xs font-semibold animate-soft bg-accent-soft text-accent">
          <span class="preview-dl-idle flex items-center justify-center gap-1.5">
            <svg class="h-3.5 w-3.5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
            Processing...
          </span>
          <span class="preview-dl-ready hidden flex items-center justify-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
            Download Ready
          </span>
        </button>
      </div>
    </div>
  </template>

  <!-- Trust signals -->
  <div class="mt-6 grid gap-3 sm:grid-cols-3" role="complementary" aria-label="Privacy and security assurances">
    <div class="flex items-center gap-2 rounded-xl bg-accent-soft/50 px-4 py-3">
      <svg class="h-4 w-4 flex-shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      <span class="text-xs font-medium text-text-secondary">Secure local processing</span>
    </div>
    <div class="flex items-center gap-2 rounded-xl bg-accent-soft/50 px-4 py-3">
      <svg class="h-4 w-4 flex-shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      <span class="text-xs font-medium text-text-secondary">Files auto-deleted</span>
    </div>
    <div class="flex items-center gap-2 rounded-xl bg-accent-soft/50 px-4 py-3">
      <svg class="h-4 w-4 flex-shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
      <span class="text-xs font-medium text-text-secondary">No account required</span>
    </div>
  </div>

  <!-- AdSense slot reservation -->
  <div class="ad-slot mt-6 rounded-2xl border border-border-secondary bg-surface-card p-4 text-center" aria-label="Advertisement">
    <p class="text-[10px] uppercase tracking-widest text-text-tertiary">Advertisement</p>
    <div class="mt-2 flex h-24 items-center justify-center rounded-xl bg-surface-secondary text-xs text-text-tertiary">
      Ad Slot — 728×90
    </div>
  </div>
</div>

<script>
  // ==========================================
  // IMAGE TOOLS ENGINE — Client-side processing
  // ==========================================
  const app = document.getElementById('image-tools-app')!;
  const maxBytes = parseInt(app.dataset.maxBytes!);
  const acceptedTypes = ['image/jpeg','image/png','image/webp','image/gif','image/bmp','image/tiff'];
  const pdfMime = 'application/pdf';

  // DOM refs
  const dropZone = document.getElementById('tools-drop-zone')!;
  const fileInput = document.getElementById('tools-file-input') as HTMLInputElement;
  const workspace = document.getElementById('tools-workspace')!;
  const fileCount = document.getElementById('tools-file-count')!;
  const clearBtn = document.getElementById('tools-clear-btn')!;
  const downloadAll = document.getElementById('tools-download-all')!;
  const previewGrid = document.getElementById('tools-preview-grid')!;
  const previewCount = document.getElementById('tools-preview-count')!;
  const template = document.getElementById('tools-preview-template') as HTMLTemplateElement;
  const panels = document.getElementById('tools-panels')!;
  const trustRow = document.getElementById('tools-trust-row')!;

  // State
  let files: File[] = [];
  let activeTool = 'resize';
  // Pipeline: maps each original file to its cumulative processed blob (chained operations)
  const pipelineBlobs = new Map<File, Blob>();

  // --- Drag & Drop ---
  const dropLabel = dropZone.querySelector('label')!;
  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropLabel.classList.add('border-accent','bg-accent-soft/40','scale-[1.01]','shadow-lg');
  });
  dropZone.addEventListener('dragleave', () => {
    dropLabel.classList.remove('border-accent','bg-accent-soft/40','scale-[1.01]','shadow-lg');
  });
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropLabel.classList.remove('border-accent','bg-accent-soft/40','scale-[1.01]','shadow-lg');
    handleFiles(Array.from(e.dataTransfer?.files ?? []));
  });
  fileInput.addEventListener('change', () => { handleFiles(Array.from(fileInput.files ?? [])); fileInput.value = ''; });
  clearBtn.addEventListener('click', resetAll);
  downloadAll.addEventListener('click', processAndDownloadAll);

  // --- Clipboard paste support (Ctrl+V / Cmd+V) ---
  document.addEventListener('paste', (e: ClipboardEvent) => {
    const items = e.clipboardData?.items;
    if (!items) return;
    const imageFiles: File[] = [];
    for (let i = 0; i < items.length; i++) {
      const item = items[i];
      if (item.type.startsWith('image/')) {
        const blob = item.getAsFile();
        if (blob) imageFiles.push(blob);
      }
    }
    if (imageFiles.length > 0) {
      e.preventDefault();
      handleFiles(imageFiles);
      toast(`${imageFiles.length} image${imageFiles.length!==1?'s':''} pasted from clipboard`, 'info');
    }
  });

  function handleFiles(incoming: File[]) {
    const isPdfTab = activeTool === 'pdfcompress';
    const valid = incoming.filter(f => {
      if (f.type === pdfMime) {
        if (!isPdfTab) { toast(`"${f.name}" is a PDF. Please use the <a href="/compress-pdf" style="text-decoration:underline">PDF Compress</a> tool.`,'error'); return false; }
        return true;
      }
      if (isPdfTab) { toast(`"${f.name}" is not a PDF. Switch to the Compress tab for images.`,'error'); return false; }
      if (!acceptedTypes.includes(f.type)) { toast(`"${f.name}" is not supported`,'error'); return false; }
      if (f.size > maxBytes) { toast(`"${f.name}" exceeds limit`,'error'); return false; }
      return true;
    });
    if (valid.length === 0) return;
    files = [...files, ...valid];
    dropZone.classList.add('hidden');
    trustRow.classList.add('hidden');
    workspace.classList.remove('hidden');
    updatePreviews();
  }

  function resetAll() {
    // Revoke all blob URLs before clearing DOM to prevent memory leaks
    previewGrid.querySelectorAll('.preview-card').forEach(card => {
      const orig = card.getAttribute('data-orig-url');
      const blob = card.getAttribute('data-blob-url');
      if (orig) URL.revokeObjectURL(orig);
      if (blob) URL.revokeObjectURL(blob);
    });
    pipelineBlobs.clear();
    files = [];
    previewGrid.innerHTML = '';
    dropZone.classList.remove('hidden');
    trustRow.classList.remove('hidden');
    workspace.classList.add('hidden');
  }

  // --- Preview rendering ---
  function updatePreviews() {
    // Revoke all old blob URLs before clearing to prevent memory leaks
    previewGrid.querySelectorAll('.preview-card').forEach(card => {
      const orig = card.getAttribute('data-orig-url');
      const blob = card.getAttribute('data-blob-url');
      if (orig) URL.revokeObjectURL(orig);
      if (blob) URL.revokeObjectURL(blob);
    });
    previewGrid.innerHTML = '';
    const hasPdfs = files.some(f => f.type === pdfMime && activeTool === 'pdfcompress');
    fileCount.textContent = `${files.length} file${files.length!==1?'s':''} selected`;
    previewCount.textContent = `${files.length} ${hasPdfs ? 'file' : 'image'}${files.length!==1?'s':''} loaded`;
    files.forEach((file) => {
      const clone = template.content.cloneNode(true) as HTMLElement;
      const card = clone.querySelector('.preview-card')!;
      const origImg = clone.querySelector('.preview-orig-img') as HTMLImageElement;
      const origImgWrap = origImg.parentElement!;
      const canvas = clone.querySelector('.preview-canvas') as HTMLCanvasElement;
      const nameEl = clone.querySelector('.preview-name')!;
      const origSizeEl = clone.querySelector('.preview-orig-size')!;
      const newSizeEl = clone.querySelector('.preview-new-size')!;
      const savingsEl = clone.querySelector('.preview-savings')!;
      const dlBtn = clone.querySelector('.preview-download')!;
      const idleSpan = clone.querySelector('.preview-dl-idle')!;
      const readySpan = clone.querySelector('.preview-dl-ready')!;

      const isPdf = file.type === pdfMime && activeTool === 'pdfcompress';

      if (isPdf) {
        // Show PDF document icon instead of broken image
        origImg.style.display = 'none';
        const pdfIcon = document.createElement('div');
        pdfIcon.className = 'flex items-center justify-center h-full w-full';
        pdfIcon.innerHTML = `<svg class="h-8 w-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/><text x="8" y="16" font-size="6" fill="currentColor" stroke="none" font-weight="bold">PDF</text></svg>`;
        origImgWrap.appendChild(pdfIcon);
      } else {
        const url = URL.createObjectURL(file);
        origImg.src = url;
        card.setAttribute('data-orig-url', url);
      }
      nameEl.textContent = file.name;
      origSizeEl.textContent = formatBytes(file.size);
      newSizeEl.textContent = '...';

      // Auto-processing label so users see immediate feedback
      const spinnerSvg = idleSpan.querySelector('svg');
      idleSpan.innerHTML = (spinnerSvg ? spinnerSvg.outerHTML : '') + (isPdf ? ' Initializing...' : ' Processing...');

      // Atomic processing counter to prevent stale results
      let procCounter = parseInt(card.getAttribute('data-process-id') || '0') + 1;
      card.setAttribute('data-process-id', String(procCounter));

      // Use pipeline blob as source so operations chain cumulatively
      const sourceBlob = pipelineBlobs.get(file);
      processFile(file, activeTool, sourceBlob, isPdf ? (msg: string) => {
        if (msg === 'Complete!') return; // finally block signal — .then() handles the transition
        idleSpan.innerHTML = `<svg class="h-3.5 w-3.5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> ${msg}`;
      } : undefined).then(result => {
        if (parseInt(card.getAttribute('data-process-id') || '0') !== procCounter) return;
        // Update pipeline so the next tool inherits this cumulative result
        pipelineBlobs.set(file, result.blob);
        const newUrl = URL.createObjectURL(result.blob);
        // Store processed blob data on the card for reliable downloads
        const prevUrl = card.getAttribute('data-blob-url');
        if (prevUrl) URL.revokeObjectURL(prevUrl);
        card.setAttribute('data-blob-url', newUrl);
        card.setAttribute('data-filename', result.filename);
        const szEl1 = card.querySelector('.preview-new-size'); if (szEl1) szEl1.textContent = formatBytes(result.blob.size);

        if (isPdf) {
          // PDF result — show success icon on canvas area
          canvas.width = 200; canvas.height = 200;
          const pctx = canvas.getContext('2d')!;
          pctx.fillStyle = '#f0fdf4'; pctx.fillRect(0, 0, 200, 200);
          pctx.fillStyle = '#16a34a'; pctx.font = 'bold 14px system-ui';
          pctx.textAlign = 'center';
          pctx.fillText('✓ PDF Compressed', 100, 90);
          pctx.fillStyle = '#166534'; pctx.font = '11px system-ui';
          pctx.fillText(formatBytes(result.blob.size), 100, 115);
        } else {
          // Image result — render canvas preview
          const previewImg = new Image();
          previewImg.onload = () => {
            canvas.width = previewImg.naturalWidth;
            canvas.height = previewImg.naturalHeight;
            const pctx2 = canvas.getContext('2d')!;
            pctx2.imageSmoothingEnabled = true;
            pctx2.imageSmoothingQuality = 'high';
            pctx2.drawImage(previewImg, 0, 0);
          };
          previewImg.src = newUrl;
        }

        const origBytes = file.size;
        const newBytes = result.blob.size;
        savingsEl.classList.remove('hidden');
        if ((result as any).keptOriginal) {
          savingsEl.className = 'inline-flex items-center gap-1 rounded-md bg-blue-100 border border-blue-200 px-2 py-1 text-[10px] font-bold text-blue-700';
          savingsEl.innerHTML = '<span>Already Optimized</span><span class="font-normal text-blue-600">(0% Saved)</span>';
        } else if (newBytes < origBytes) {
          const pct = Math.round((1 - newBytes / origBytes) * 100);
          const saved = formatBytes(origBytes - newBytes);
          savingsEl.className = 'inline-flex items-center gap-1 rounded-md bg-green-100 border border-green-200 px-2 py-1 text-[10px] font-bold text-green-700';
          savingsEl.innerHTML = `<span>${pct}% smaller</span><span class="font-normal text-green-600">(${formatBytes(origBytes)} → ${formatBytes(newBytes)})</span>`;
        } else if (newBytes > origBytes) {
          const pct = Math.round((newBytes / origBytes - 1) * 100);
          savingsEl.className = 'inline-flex items-center gap-1 rounded-md bg-amber-100 border border-amber-200 px-2 py-1 text-[10px] font-bold text-amber-700';
          savingsEl.innerHTML = `<span>${pct}% larger</span><span class="font-normal text-amber-600">(${formatBytes(origBytes)} → ${formatBytes(newBytes)})</span>`;
        } else {
          savingsEl.className = 'inline-flex items-center rounded-md bg-gray-100 border border-gray-200 px-2 py-1 text-[10px] font-bold text-gray-600';
          savingsEl.textContent = 'Same size';
        }

        // Transition button: Processing → Download Ready
        idleSpan.classList.add('hidden');
        readySpan.classList.remove('hidden');
        dlBtn.className = dlBtn.className.replace('bg-accent-soft text-accent', 'bg-accent text-white hover:bg-accent-hover hover:shadow-sm');
      }).catch(err => {
        console.error('Processing failed:', err);
        newSizeEl.textContent = '⚠ Error';
        canvas.width = 200; canvas.height = 200;
        const pctx = canvas.getContext('2d')!;
        pctx.fillStyle = '#fef2f2'; pctx.fillRect(0, 0, 200, 200);
        pctx.fillStyle = '#dc2626'; pctx.font = 'bold 12px system-ui';
        pctx.textAlign = 'center';
        pctx.fillText('⚠ Processing failed', 100, 90);
        pctx.fillStyle = '#991b1b'; pctx.font = '10px system-ui';
        pctx.fillText('Original file available', 100, 112);
        // Fallback: download original file
        const fallbackUrl = URL.createObjectURL(file);
        card.setAttribute('data-blob-url', fallbackUrl);
        card.setAttribute('data-filename', file.name);
        savingsEl.classList.remove('hidden');
        savingsEl.className = 'inline-flex items-center rounded-md bg-red-100 border border-red-200 px-2 py-1 text-[10px] font-bold text-red-700';
        savingsEl.textContent = 'Original file';
        idleSpan.classList.add('hidden');
        readySpan.classList.remove('hidden');
        dlBtn.className = dlBtn.className.replace('bg-accent-soft text-accent', 'bg-accent text-white hover:bg-accent-hover hover:shadow-sm');
      }).finally(() => {
        // Guarantee loading spinner is always turned off
        const cw = canvas.parentElement;
        if (cw) cw.classList.remove('preview-loading');
      });

      // Download handler with iframe fallback for managed Chrome browsers
      dlBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const blobUrl = card.getAttribute('data-blob-url');
        const filename = card.getAttribute('data-filename');
        if (blobUrl && filename) {
          triggerDownload(blobUrl, filename);
        }
      });

      previewGrid.appendChild(clone);
    });
  }

  // Download All — uses already-processed blob URLs from preview cards
  function processAndDownloadAll() {
    const cards = previewGrid.querySelectorAll('.preview-card');
    if (cards.length === 0) return;
    cards.forEach((card, i) => {
      const blobUrl = card.getAttribute('data-blob-url');
      const filename = card.getAttribute('data-filename');
      if (blobUrl && filename) {
        setTimeout(() => triggerDownload(blobUrl, filename), i * 300);
      }
    });
  }

  // Unified download trigger — anchor first, iframe fallback for managed Chrome
  function triggerDownload(url: string, filename: string) {
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    // For managed Chrome (enterprise policies blocking blob: downloads),
    // also open in an iframe which forces a navigation-based download
    setTimeout(() => {
      if (document.body.contains(a)) document.body.removeChild(a);
    }, 1000);
  }

  // --- Core processing ---
  // sourceBlob: if provided (from pipeline), use as image source instead of raw file — enables operation chaining
  async function processFile(file: File, tool: string, sourceBlob: Blob | undefined, onProgress?: (msg: string) => void): Promise<{ blob: Blob; filename: string }> {
    // PDF compression path — no image loading needed, uses pdf.js
    if (file.type === pdfMime && tool === 'pdfcompress') {
      return compressPDF(file, onProgress);
    }

    // Use pipeline blob if available (chained operations), otherwise load raw file
    const img = sourceBlob ? await blobToImage(sourceBlob) : await loadImage(file);
    let canvas: HTMLCanvasElement;
    let outputType = file.type;
    let ext = file.name.split('.').pop()!;

    switch (tool) {
      case 'resize': {
        const w = parseInt((document.getElementById('resize-w') as HTMLInputElement).value) || 800;
        const h = parseInt((document.getElementById('resize-h') as HTMLInputElement).value) || 600;
        const keepAspect = (document.getElementById('resize-aspect') as HTMLInputElement).checked;
        canvas = resizeImage(img, w, h, keepAspect);
        break;
      }
      case 'compress': {
        const quality = parseInt((document.getElementById('compress-slider') as HTMLInputElement).value) / 100;
        const cc = createCanvas(img.naturalWidth, img.naturalHeight);
        canvas = cc.canvas;
        cc.ctx.drawImage(img, 0, 0);
        return new Promise(resolve => {
          // Always compress to JPEG so the quality slider visibly reduces file size
          // (PNG is lossless and ignores quality, making the slider appear broken)
          canvas.toBlob(b => resolve({
            blob: b!,
            filename: file.name.replace(/\.[^.]+$/, '.jpg'),
          }), 'image/jpeg', quality);
        });
      }
      case 'convert': {
        const fmt = (document.getElementById('convert-format') as HTMLSelectElement).value;
        const q = parseInt((document.getElementById('convert-quality') as HTMLInputElement).value) / 100;
        const cc = createCanvas(img.naturalWidth, img.naturalHeight);
        canvas = cc.canvas;
        cc.ctx.drawImage(img, 0, 0);
        return convertToFormat(canvas, file.name, fmt, q, img.naturalWidth, img.naturalHeight);
      }
      case 'crop': {
        // Clamp source rect strictly inside image bounds — prevents blank canvases
        const imgW = img.naturalWidth;
        const imgH = img.naturalHeight;
        const x = Math.max(0, Math.min(imgW - 1, parseInt((document.getElementById('crop-x') as HTMLInputElement).value) || 0));
        const y = Math.max(0, Math.min(imgH - 1, parseInt((document.getElementById('crop-y') as HTMLInputElement).value) || 0));
        let cw = parseInt((document.getElementById('crop-w') as HTMLInputElement).value);
        let ch = parseInt((document.getElementById('crop-h') as HTMLInputElement).value);
        // Sentinel: 0 or NaN means "use full remaining image"
        if (!cw || cw <= 0) cw = imgW - x;
        if (!ch || ch <= 0) ch = imgH - y;
        cw = Math.max(1, Math.min(imgW - x, cw));
        ch = Math.max(1, Math.min(imgH - y, ch));
        const cc3 = createCanvas(cw, ch);
        canvas = cc3.canvas;
        cc3.ctx.drawImage(img, x, y, cw, ch, 0, 0, cw, ch);
        break;
      }
      case 'rotate': {
        const active = document.querySelector('.rotate-btn.bg-accent-soft');
        if (!active) {
          // No rotate button explicitly chosen — passthrough image unchanged
          const cc3 = createCanvas(img.naturalWidth, img.naturalHeight);
          canvas = cc3.canvas;
          cc3.ctx.drawImage(img, 0, 0);
          break;
        }
        const degRaw = (active as HTMLElement).dataset.rotate!;
        const deg = degRaw === 'custom'
          ? (parseInt((document.getElementById('rotate-custom-deg') as HTMLInputElement).value) || 0)
          : parseInt(degRaw);
        canvas = rotateImage(img, isNaN(deg) ? 0 : deg);
        break;
      }
      case 'filters': {
        const activeFilter = document.querySelector('.filter-btn.bg-accent-soft');
        if (!activeFilter) {
          // No filter button explicitly chosen — passthrough image unchanged
          const cc3 = createCanvas(img.naturalWidth, img.naturalHeight);
          canvas = cc3.canvas;
          cc3.ctx.drawImage(img, 0, 0);
          break;
        }
        const filterId = (activeFilter as HTMLElement).dataset.filter!;
        canvas = applyFilter(img, filterId);
        break;
      }
      default: {
        const cc2 = createCanvas(img.naturalWidth, img.naturalHeight);
        canvas = cc2.canvas;
        cc2.ctx.drawImage(img, 0, 0);
      }
    }

    // Capture canvas reference before async toBlob to prevent GC
    const outCanvas = canvas;
    const outType = outputType;
    return new Promise(resolve => {
      outCanvas.toBlob(b => resolve({ blob: b!, filename: file.name }), outType, 0.92);
    });
  }

  // --- Image operations ---
  function loadImage(file: File): Promise<HTMLImageElement> {
    return new Promise((resolve, reject) => {
      const r = new FileReader();
      r.onload = () => { const i = new Image(); i.onload = () => resolve(i); i.onerror = reject; i.src = r.result as string; };
      r.onerror = reject;
      r.readAsDataURL(file);
    });
  }

  // Load a Blob as an HTMLImageElement — used by the pipeline to feed previous results into the next tool
  function blobToImage(blob: Blob): Promise<HTMLImageElement> {
    return new Promise((resolve, reject) => {
      const url = URL.createObjectURL(blob);
      const img = new Image();
      img.onload = () => { URL.revokeObjectURL(url); resolve(img); };
      img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('Failed to load pipeline blob as image')); };
      img.src = url;
    });
  }

  // Create a canvas with maximum-quality smoothing enabled
  function createCanvas(w: number, h: number): { canvas: HTMLCanvasElement; ctx: CanvasRenderingContext2D } {
    const canvas = document.createElement('canvas');
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d')!;
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    return { canvas, ctx };
  }

  function resizeImage(img: HTMLImageElement, w: number, h: number, keepAspect: boolean): HTMLCanvasElement {
    let cw: number, ch: number;
    if (keepAspect) {
      const ratio = Math.min(w / img.naturalWidth, h / img.naturalHeight);
      cw = Math.round(img.naturalWidth * ratio);
      ch = Math.round(img.naturalHeight * ratio);
    } else {
      cw = w;
      ch = h;
    }
    const { canvas, ctx } = createCanvas(cw, ch);
    ctx.drawImage(img, 0, 0, cw, ch);
    return canvas;
  }

  function rotateImage(img: HTMLImageElement, deg: number): HTMLCanvasElement {
    const rad = deg * Math.PI / 180;
    const sin = Math.abs(Math.sin(rad)), cos = Math.abs(Math.cos(rad));
    const cw = Math.round(img.naturalWidth * cos + img.naturalHeight * sin);
    const ch = Math.round(img.naturalWidth * sin + img.naturalHeight * cos);
    const { canvas, ctx } = createCanvas(cw, ch);
    ctx.translate(cw/2, ch/2);
    ctx.rotate(rad);
    ctx.drawImage(img, -img.naturalWidth/2, -img.naturalHeight/2);
    return canvas;
  }

  function applyFilter(img: HTMLImageElement, filterId: string): HTMLCanvasElement {
    const { canvas, ctx } = createCanvas(img.naturalWidth, img.naturalHeight);
    ctx.drawImage(img, 0, 0);
    if (filterId === 'none') return canvas;

    const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
    const d = imageData.data;
    for (let i = 0; i < d.length; i += 4) {
      const r = d[i], g = d[i+1], b = d[i+2];
      switch (filterId) {
        case 'grayscale': { const avg = 0.299*r + 0.587*g + 0.114*b; d[i]=d[i+1]=d[i+2]=avg; break; }
        case 'sepia': { d[i]=Math.min(255,r*0.393+g*0.769+b*0.189); d[i+1]=Math.min(255,r*0.349+g*0.686+b*0.168); d[i+2]=Math.min(255,r*0.272+g*0.534+b*0.131); break; }
        case 'invert': { d[i]=255-r; d[i+1]=255-g; d[i+2]=255-b; break; }
        case 'brightness-up': { d[i]=Math.min(255,r+40); d[i+1]=Math.min(255,g+40); d[i+2]=Math.min(255,b+40); break; }
        case 'brightness-down': { d[i]=Math.max(0,r-40); d[i+1]=Math.max(0,g-40); d[i+2]=Math.max(0,b-40); break; }
      }
    }
    ctx.putImageData(imageData, 0, 0);
    return canvas;
  }

  // ==========================================
  // FORMAT CONVERSION ENGINE
  // ==========================================

  // Dynamic jsPDF import (lazy-loaded, ~400KB, code-split by Vite)
  let _jsPDF: typeof import('jspdf') | null = null;
  async function getJsPDF() {
    if (!_jsPDF) { const m = await import('jspdf'); _jsPDF = m; }
    return _jsPDF;
  }

  const FORMAT_EXT: Record<string,string> = {
    'image/jpeg':'jpg','image/png':'png','image/webp':'webp','image/svg+xml':'svg',
    'application/pdf':'pdf',
    'application/vnd.openxmlformats-officedocument.wordprocessingml.document':'docx',
    'application/vnd.openxmlformats-officedocument.presentationml.presentation':'pptx',
    'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet':'xlsx',
    'text/html':'html',
  };

  async function convertToFormat(canvas: HTMLCanvasElement, origName: string, mime: string, quality: number, origW: number, origH: number): Promise<{blob:Blob;filename:string}> {
    const ext = FORMAT_EXT[mime] || 'bin';
    const baseName = origName.replace(/\.[^.]+$/, '');
    const w = canvas.width;
    const h = canvas.height;

    switch (mime) {
      case 'image/jpeg': case 'image/png': case 'image/webp':
        return new Promise(resolve => canvas.toBlob(b => resolve({blob:b!,filename:`${baseName}.${ext}`}), mime, quality));

      case 'image/svg+xml': {
        // Lossless PNG at maximum quality for the embedded vector wrapper
        const dataUrl = canvas.toDataURL('image/png', 1.0);
        const svg = `<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">\n  <image width="${w}" height="${h}" image-rendering="auto" xlink:href="${dataUrl}"/>\n</svg>`;
        return { blob: new Blob([svg], {type:'image/svg+xml'}), filename: `${baseName}.svg` };
      }

      case 'application/pdf': {
        // Use lossless PNG when quality is 100%, otherwise JPEG at requested quality
        const { jsPDF } = await getJsPDF();
        const usePng = quality >= 1.0;
        const dataUrl = canvas.toDataURL(usePng ? 'image/png' : 'image/jpeg', quality);
        const doc = new jsPDF({
          orientation: w > h ? 'landscape' : 'portrait',
          unit: 'px',
          format: [w, h],
          hotfixes: ['px_scaling'],
        });
        doc.addImage(dataUrl, usePng ? 'PNG' : 'JPEG', 0, 0, w, h, undefined, 'NONE');
        return { blob: doc.output('blob'), filename: `${baseName}.pdf` };
      }

      case 'text/html': {
        // Lossless PNG for standalone web page
        const dataUrl = canvas.toDataURL('image/png', 1.0);
        const html = `<!DOCTYPE html>\n<html lang="en">\n<head><meta charset="UTF-8"><title>${baseName}</title>\n<style>body{display:flex;justify-content:center;align-items:center;min-height:100vh;margin:0;background:#f5f5f5}img{max-width:100%;height:auto;box-shadow:0 8px 30px rgba(0,0,0,0.12);border-radius:8px}</style>\n</head>\n<body><img src="${dataUrl}" alt="${baseName}" width="${w}" height="${h}"></body>\n</html>`;
        return { blob: new Blob([html], {type:'text/html'}), filename: `${baseName}.html` };
      }

      // Office Open XML via minimal ZIP container — full resolution PNG inside
      case 'application/vnd.openxmlformats-officedocument.wordprocessingml.document': {
        const dataUrl = canvas.toDataURL('image/png', 1.0);
        const emuW = Math.round(w * 9525);
        const emuH = Math.round(h * 9525);
        const docXml = `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><w:body><w:p><w:r><w:drawing><wp:inline xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" distT="0" distB="0" distL="0" distR="0"><wp:extent cx="${emuW}" cy="${emuH}"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="1" name="Picture 1"/><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="image1"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId1"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="${emuW}" cy="${emuH}"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p></w:body></w:document>`;
        const typesXml = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="png" ContentType="image/png"/><Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/></Types>';
        const relsXml = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="media/image1.png"/></Relationships>';
        const docRelsXml = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/></Relationships>';
        const imgBytes = dataUrlToBytes(dataUrl);
        const zip = createZip([
          {name:'[Content_Types].xml', data:typesXml},
          {name:'_rels/.rels', data:docRelsXml},
          {name:'word/document.xml', data:docXml},
          {name:'word/_rels/document.xml.rels', data:relsXml},
          {name:'word/media/image1.png', data:imgBytes, raw:true},
        ]);
        return { blob: zip, filename: `${baseName}.docx` };
      }

      case 'application/vnd.openxmlformats-officedocument.presentationml.presentation': {
        const dataUrl = canvas.toDataURL('image/png', 1.0);
        const emuW = Math.round(w * 12700);
        const emuH = Math.round(h * 12700);
        const slideW = Math.max(emuW, 12192000);
        const slideH = Math.max(emuH, 6858000);
        const slideXml = `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><p:sld xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><p:cSld><p:sp><p:nvSpPr><p:cNvPr id="1" name="Image"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="${emuW}" cy="${emuH}"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:blipFill><a:blip r:embed="rId1"/><a:stretch><a:fillRect/></a:stretch></p:blipFill></p:sp></p:cSld></p:sld>`;
        const typesXml = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="png" ContentType="image/png"/><Override PartName="/ppt/slides/slide1.xml" ContentType="application/vnd.openxmlformats-officedocument.presentationml.slide+xml"/><Override PartName="/ppt/presentation.xml" ContentType="application/vnd.openxmlformats-officedocument.presentationml.presentation.main+xml"/></Types>';
        const presXml = `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><p:presentation xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><p:sldIdLst><p:sldId id="256" r:id="rId1"/></p:sldIdLst><p:sldSz cx="${slideW}" cy="${slideH}"/></p:presentation>`;
        const slideRels = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="../media/image1.png"/></Relationships>';
        const presRels = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/slide" Target="slides/slide1.xml"/></Relationships>';
        const rootRels = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="ppt/presentation.xml"/></Relationships>';
        const imgBytes = dataUrlToBytes(dataUrl);
        const zip = createZip([
          {name:'[Content_Types].xml', data:typesXml},
          {name:'_rels/.rels', data:rootRels},
          {name:'ppt/presentation.xml', data:presXml},
          {name:'ppt/_rels/presentation.xml.rels', data:presRels},
          {name:'ppt/slides/slide1.xml', data:slideXml},
          {name:'ppt/slides/_rels/slide1.xml.rels', data:slideRels},
