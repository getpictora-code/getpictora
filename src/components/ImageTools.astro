        return { blob: zip, filename: `${baseName}.xlsx` };
      }

      default:
        return new Promise(resolve => canvas.toBlob(b => resolve({blob:b!,filename:`${baseName}.png`}), 'image/png', 1.0));
    }
  }

  // Minimal ZIP creator (uncompressed STORE method)
  function createZip(files: {name:string;data:string|Uint8Array;raw?:boolean}[]): Blob {
    const encoder = new TextEncoder();
    const parts: Uint8Array[] = [];
    const cdEntries: Uint8Array[] = [];
    let cdOffset = 0;

    for (const f of files) {
      const nameBytes = encoder.encode(f.name);
      const data = f.raw ? (f.data as Uint8Array) : encoder.encode(f.data as string);
      const crc = crc32(data);

      // Local file header
      const lh = new Uint8Array(30 + nameBytes.length);
      const lhView = new DataView(lh.buffer);
      lhView.setUint32(0, 0x04034b50, true);  // signature
      lhView.setUint16(4, 20, true);           // version needed
      lhView.setUint16(6, 0, true);            // flags
      lhView.setUint16(8, 0, true);            // compression (STORE)
      lhView.setUint16(10, 0, true);           // mod time
      lhView.setUint16(12, 0, true);           // mod date
      lhView.setUint32(14, crc, true);          // crc-32
      lhView.setUint32(18, data.length, true);  // compressed size
      lhView.setUint32(22, data.length, true);  // uncompressed size
      lhView.setUint16(26, nameBytes.length, true); // filename length
      lhView.setUint16(28, 0, true);            // extra field length
      lh.set(nameBytes, 30);
      parts.push(lh, data);
      cdOffset += lh.length + data.length;

      // Central directory entry
      const cd = new Uint8Array(46 + nameBytes.length);
      const cdView = new DataView(cd.buffer);
      cdView.setUint32(0, 0x02014b50, true);
      cdView.setUint16(4, 20, true);  // version made by
      cdView.setUint16(6, 20, true);  // version needed
      cdView.setUint16(8, 0, true);   // flags
      cdView.setUint16(10, 0, true);  // compression
      cdView.setUint16(12, 0, true);  // mod time
      cdView.setUint16(14, 0, true);  // mod date
      cdView.setUint32(16, crc, true);
      cdView.setUint32(20, data.length, true);
      cdView.setUint32(24, data.length, true);
      cdView.setUint16(28, nameBytes.length, true);
      cdView.setUint16(30, 0, true);   // extra field length
      cdView.setUint16(32, 0, true);   // file comment length
      cdView.setUint16(34, 0, true);   // disk number start
      cdView.setUint16(36, 0, true);   // internal file attributes
      cdView.setUint32(38, 0, true);   // external file attributes
      cdView.setUint32(42, cdOffset - lh.length - data.length, true); // local header offset
      cd.set(nameBytes, 46);
      cdEntries.push(cd);
    }

    const cdStart = cdOffset;
    const cdData = new Uint8Array(cdEntries.reduce((s,c) => s + c.length, 0));
    let cdPos = 0;
    for (const c of cdEntries) { cdData.set(c, cdPos); cdPos += c.length; }

    // End of central directory record
    const eocd = new Uint8Array(22);
    const eocdView = new DataView(eocd.buffer);
    eocdView.setUint32(0, 0x06054b50, true);
    eocdView.setUint16(4, 0, true);          // disk number
    eocdView.setUint16(6, 0, true);          // disk with cd
    eocdView.setUint16(8, files.length, true); // entries on disk
    eocdView.setUint16(10, files.length, true); // total entries
    eocdView.setUint32(12, cdData.length, true); // cd size
    eocdView.setUint32(16, cdStart, true);     // cd offset
    eocdView.setUint16(20, 0, true);           // comment length

    parts.push(cdData, eocd);
    const totalLen = parts.reduce((s,p) => s + p.length, 0);
    const result = new Uint8Array(totalLen);
    let offset = 0;
    for (const p of parts) { result.set(p, offset); offset += p.length; }
    return new Blob([result], {type:'application/zip'});
  }

  // CRC-32 for ZIP
  function crc32(data: Uint8Array): number {
    let crc = 0xFFFFFFFF;
    for (let i = 0; i < data.length; i++) {
      crc ^= data[i];
      for (let j = 0; j < 8; j++) crc = (crc >>> 1) ^ (crc & 1 ? 0xEDB88320 : 0);
    }
    return (crc ^ 0xFFFFFFFF) >>> 0;
  }

  // Strip data: URL prefix, return raw bytes
  function dataUrlToBytes(dataUrl: string): Uint8Array {
    const b64 = dataUrl.split(',')[1];
    const binary = atob(b64);
    const bytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    return bytes;
  }

  // ==========================================
  // PDF COMPRESSION ENGINE (pdfjs-dist + jsPDF)
  // ==========================================

  let _pdfjs: typeof import('pdfjs-dist') | null = null;
  // Primary: CDN-loaded pdf.js v3.11.174 with matching worker (most reliable)
  async function getPdfJs(): Promise<any> {
    const PDFJS_CDN = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
    const PDFJS_WORKER = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    const win = window as any;
    if (win.pdfjsLib) {
      win.pdfjsLib.GlobalWorkerOptions.workerSrc = PDFJS_WORKER;
      return win.pdfjsLib;
    }
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = PDFJS_CDN;
      s.onload = () => {
        const lib = win.pdfjsLib;
        if (!lib) return reject(new Error('pdfjsLib not found'));
        lib.GlobalWorkerOptions.workerSrc = PDFJS_WORKER;
        resolve(lib);
      };
      s.onerror = () => reject(new Error('CDN script load failed'));
      document.head.appendChild(s);
    });
  }

  async function compressPDF(file: File, onProgress?: (msg: string) => void): Promise<{ blob: Blob; filename: string; keptOriginal?: boolean }> {
    const baseName = file.name.replace(/\.[^.]+$/, '');
    let resultBlob: Blob = new Blob([file], { type: pdfMime });
    let resultName = `${baseName}-compressed.pdf`;
    let keptOriginal = true;

    try {
      if (onProgress) onProgress('Initializing engine...');
      const pdfjs = await getPdfJs();
      const { jsPDF } = await getJsPDF();

      const arrayBuf = await file.arrayBuffer();
      if (onProgress) onProgress('Parsing document...');
      const pdfDoc = await pdfjs.getDocument({
        data: arrayBuf,
        useWorkerFetch: false,
        isEvalSupported: false,
      }).promise;
      const totalPages = pdfDoc.numPages;

    const scale = parseInt((document.getElementById('pdfcomp-scale') as HTMLInputElement).value) / 100 || 0.85;
    const quality = parseInt((document.getElementById('pdfcomp-quality') as HTMLInputElement).value) / 100 || 0.85;

    const pageImages: { canvas: HTMLCanvasElement; w: number; h: number }[] = [];

    for (let i = 1; i <= totalPages; i++) {
      if (onProgress) onProgress(`Rendering page ${i} of ${totalPages}...`);
      const page = await pdfDoc.getPage(i);
      const viewport = page.getViewport({ scale });
      const { canvas, ctx } = createCanvas(Math.ceil(viewport.width), Math.ceil(viewport.height));
      await page.render({ canvasContext: ctx, viewport }).promise;
      pageImages.push({ canvas, w: viewport.width, h: viewport.height });
      await new Promise(r => setTimeout(r, 0));
    }

    if (pageImages.length === 0) throw new Error('No pages in PDF');

    if (onProgress) onProgress('Packaging PDF...');
    const first = pageImages[0];
    const doc = new jsPDF({
      orientation: first.w > first.h ? 'landscape' : 'portrait',
      unit: 'px',
      format: [first.w, first.h],
      hotfixes: ['px_scaling'],
    });

    // Use PNG (lossless) at quality >= 0.95, JPEG otherwise
    const usePng = quality >= 0.95;
    const imgFormat = usePng ? 'PNG' : 'JPEG';
    const mimeType = usePng ? 'image/png' : 'image/jpeg';

    for (let i = 0; i < pageImages.length; i++) {
      if (i > 0) {
        doc.addPage([pageImages[i].w, pageImages[i].h], pageImages[i].w > pageImages[i].h ? 'landscape' : 'portrait');
      }
      const dataUrl = pageImages[i].canvas.toDataURL(mimeType, quality);
      doc.addImage(dataUrl, imgFormat, 0, 0, pageImages[i].w, pageImages[i].h, undefined, 'FAST');
    }

    if (onProgress) onProgress('Finalizing...');
    const outBlob = doc.output('blob') as Blob;
    await new Promise(r => setTimeout(r, 0));

    // Emergency check: if output is empty or broken, keep original
    if (!outBlob || outBlob.size === 0) {
      // keep original (already set as default)
    } else if (outBlob.size < file.size) {
      resultBlob = outBlob;
      keptOriginal = false;
    }
    // else: compressed >= original, keep original (already default)

    } catch (e) {
      console.error('PDF compression failed:', e);
      if (onProgress) onProgress('Compression failed — saving original');
      toast('PDF engine error. Downloading original file.', 'error');
      // resultBlob already defaults to original
    } finally {
      // GUARANTEED: signal UI that processing is complete
      if (onProgress) onProgress('Complete!');
    }

    return { blob: resultBlob, filename: resultName, keptOriginal };
  }

  // --- Tool switching ---
  const tabs = document.querySelectorAll<HTMLElement>('.tools-tab');
  const tabList = document.querySelector('[role="tablist"]') as HTMLElement;

  function activateTab(tab: HTMLElement) {
    const newTool = tab.getAttribute('data-tool')!;
    const wasChanged = activeTool !== newTool;
    activeTool = newTool;

    // Deactivate all: reset classes and data-active
    tabs.forEach(b => {
      b.setAttribute('aria-selected', 'false');
      b.tabIndex = -1;
      b.setAttribute('data-active', 'false');
      b.className = b.className
        .replace('bg-surface-card text-text-primary shadow-sm', 'text-text-secondary hover:text-text-primary hover:bg-surface-card/60');
    });
    // Activate the clicked tab
    tab.setAttribute('aria-selected', 'true');
    tab.tabIndex = 0;
    tab.setAttribute('data-active', 'true');
    tab.className = tab.className
      .replace('text-text-secondary hover:text-text-primary hover:bg-surface-card/60', 'bg-surface-card text-text-primary shadow-sm');
    tab.focus();
    panels.querySelectorAll('[data-panel]').forEach(p => p.classList.add('hidden'));
    panels.querySelector(`[data-panel="${activeTool}"]`)?.classList.remove('hidden');

    // Update drop zone text and file input accept based on active tool
    const dropTitle = document.getElementById('drop-title');
    const dropSubtitle = document.getElementById('drop-subtitle');
    if (activeTool === 'pdfcompress') {
      if (dropTitle) dropTitle.textContent = 'Drag & drop your PDF here';
      if (dropSubtitle) dropSubtitle.textContent = 'or click to browse — supports PDF files';
      fileInput.setAttribute('accept', '.pdf,application/pdf');
    } else {
      if (dropTitle) dropTitle.textContent = 'Drag & drop your images here';
      if (dropSubtitle) dropSubtitle.textContent = 'or click to browse — supports JPG, PNG, WebP, GIF, BMP, TIFF';
      fileInput.setAttribute('accept', 'image/jpeg,image/png,image/webp,image/gif,image/bmp,image/tiff');
    }

    // Keep files when switching tabs — re-process with new tool parameters
    if (wasChanged && files.length > 0) {
      const isPdfTool = activeTool === 'pdfcompress';
      const compatible = files.filter(f => isPdfTool ? f.type === pdfMime : f.type !== pdfMime);
      const removed = files.length - compatible.length;
      if (removed > 0) {
        // Revoke blob URLs for removed files
        previewGrid.querySelectorAll('.preview-card').forEach((card, i) => {
          if (i >= compatible.length) {
            const orig = card.getAttribute('data-orig-url');
            const blob = card.getAttribute('data-blob-url');
            if (orig) URL.revokeObjectURL(orig);
            if (blob) URL.revokeObjectURL(blob);
          }
        });
        toast(`${removed} file${removed !== 1 ? 's' : ''} not compatible with ${isPdfTool ? 'PDF Compress' : 'image tools'} — removed`, 'info');
      }
      files = compatible;
      if (files.length > 0) {
        updatePreviews();
      } else {
        // All files filtered out — reset fully
        resetAll();
      }
    }
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => activateTab(tab));
    tab.addEventListener('keydown', (e) => {
      const idx = Array.from(tabs).indexOf(tab);
      let target: HTMLElement | null = null;
      if (e.key === 'ArrowRight') target = tabs[(idx + 1) % tabs.length];
      if (e.key === 'ArrowLeft') target = tabs[(idx - 1 + tabs.length) % tabs.length];
      if (e.key === 'Home') target = tabs[0];
      if (e.key === 'End') target = tabs[tabs.length - 1];
      if (target) { e.preventDefault(); activateTab(target); }
    });
  });

  // Activate initial tool from data attribute (for dedicated tool pages)
  const initial = app.dataset.initialTool;
  if (initial) {
    const target = document.querySelector(`[data-tool="${initial}"]`) as HTMLElement;
    if (target) target.click();
  }

  // ==========================================
  // REACTIVE PREVIEW ENGINE
  // ==========================================
  let reprocessTimer: number | null = null;

  /** Re-process all files with current tool params, update canvases + badges */
  function reprocessPreviews() {
    // Delegate entirely to updatePreviews — single code path, zero race conditions
    updatePreviews();
  }

  /** Debounced version for continuous inputs (sliders, number fields) */
  function debouncedReprocess() {
    if (reprocessTimer) clearTimeout(reprocessTimer);
    reprocessTimer = window.setTimeout(reprocessPreviews, 250);
  }

  // ==========================================
  // RESIZE — Live on input, instant on presets
  // ==========================================
  const resizeW = document.getElementById('resize-w') as HTMLInputElement;
  const resizeH = document.getElementById('resize-h') as HTMLInputElement;
  const resizeAspect = document.getElementById('resize-aspect') as HTMLInputElement;

  resizeW?.addEventListener('input', debouncedReprocess);
  resizeH?.addEventListener('input', debouncedReprocess);
  resizeAspect?.addEventListener('change', reprocessPreviews);

  document.querySelectorAll('[id^="resize-preset-"]').forEach(btn => {
    btn.addEventListener('click', () => {
      const pct = btn.id === 'resize-preset-50' ? 0.5 : btn.id === 'resize-preset-75' ? 0.75 : 1;
      resizeW.value = String(Math.round(parseInt(resizeW.value || '800') * pct));
      resizeH.value = String(Math.round(parseInt(resizeH.value || '600') * pct));
      reprocessPreviews();
    });
  });

  // ==========================================
  // COMPRESS — Live on slider
  // ==========================================
  const compressSlider = document.getElementById('compress-slider') as HTMLInputElement;
  const compressVal = document.getElementById('compress-val') as HTMLElement;
  compressSlider?.addEventListener('input', () => {
    compressVal.textContent = compressSlider.value;
    debouncedReprocess();
  });

  // ==========================================
  // CONVERT — Live on format & quality change
  // ==========================================
  const convertFormat = document.getElementById('convert-format') as HTMLSelectElement;
  const convertQuality = document.getElementById('convert-quality') as HTMLInputElement;
  const convertQVal = document.getElementById('convert-qval') as HTMLElement;
  const convertQualityWrap = document.getElementById('convert-quality-wrap') as HTMLElement;

  convertFormat?.addEventListener('change', () => {
    const v = convertFormat.value;
    // Show quality slider for formats that support quality: JPEG, WebP, PDF
    const showQuality = v === 'image/jpeg' || v === 'image/webp' || v === 'application/pdf';
    convertQualityWrap.classList.toggle('hidden', !showQuality);
    reprocessPreviews();
  });
  convertQuality?.addEventListener('input', () => {
    convertQVal.textContent = convertQuality.value;
    debouncedReprocess();
  });

  // ==========================================
  // CROP — Interactive canvas with drag handles, ratio presets, overlay
  // ==========================================
  const cropCanvas = document.getElementById('crop-canvas') as HTMLCanvasElement;
  const cropCtx = cropCanvas?.getContext('2d')!;
  const cropX = document.getElementById('crop-x') as HTMLInputElement;
  const cropY = document.getElementById('crop-y') as HTMLInputElement;
  const cropW = document.getElementById('crop-w') as HTMLInputElement;
  const cropH = document.getElementById('crop-h') as HTMLInputElement;
  const cropDimLabel = document.getElementById('crop-dim-label') as HTMLElement;
  const cropInfo = document.getElementById('crop-info') as HTMLElement;

  let cropSourceImg: HTMLImageElement | null = null; // image loaded onto crop canvas
  let cropRect = { x: 0, y: 0, w: 0, h: 0 };       // in image-pixel coords
  let cropRatio = 'free';                             // 'free' | '1:1' | '4:3' | '16:9'
  let cropDisplayScale = 1;                           // display px per image px
  let cropOffsetX = 0, cropOffsetY = 0;               // image offset within canvas

  // Drag state
  let dragMode: 'move' | 'nw' | 'ne' | 'sw' | 'se' | 'n' | 's' | 'e' | 'w' | null = null;
  let dragStart = { mx: 0, my: 0, rx: 0, ry: 0, rw: 0, rh: 0 };

  const HANDLE_SIZE = 10;
  const HANDLE_HIT = 16; // hit-test radius in display px

  function getRatioValue(ratio: string): number | null {
    if (ratio === '1:1') return 1;
    if (ratio === '4:3') return 4/3;
    if (ratio === '16:9') return 16/9;
    return null;
  }

  /** Load the current source image for the crop canvas */
  function loadCropSource() {
    if (files.length === 0) { cropSourceImg = null; return; }
    const file = files[0];
    // Use pipeline blob if available (previous transforms), else raw file
    const blob = pipelineBlobs.get(file);
    const src = blob ? URL.createObjectURL(blob) : URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      if (blob) URL.revokeObjectURL(src);
      cropSourceImg = img;
      initCropFromImage();
      renderCropCanvas();
    };
    img.src = src;
  }

  /** Initialize crop rect to full image or restore from inputs */
  function initCropFromImage() {
    if (!cropSourceImg) return;
    const iw = cropSourceImg.naturalWidth;
    const ih = cropSourceImg.naturalHeight;
    // Try reading existing input values; if they look stale (w > image), reset to full
    const ex = parseInt(cropX.value) || 0;
    const ey = parseInt(cropY.value) || 0;
    const ew = parseInt(cropW.value) || 0;
    const eh = parseInt(cropH.value) || 0;
    if (ew > 0 && eh > 0 && ex + ew <= iw && ey + eh <= ih) {
      cropRect = { x: ex, y: ey, w: ew, h: eh };
    } else {
      cropRect = { x: 0, y: 0, w: iw, h: ih };
    }
  }

  /** Render the crop canvas: image + dark overlay + bright crop window + corner handles */
  function renderCropCanvas() {
    if (!cropCanvas || !cropSourceImg) return;
    const dpr = window.devicePixelRatio || 1;
    const cw = cropCanvas.clientWidth;
    const ch = Math.min(cw * 0.75, 480);
    cropCanvas.style.height = ch + 'px';
    cropCanvas.width = cw * dpr;
    cropCanvas.height = ch * dpr;
    cropCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const iw = cropSourceImg.naturalWidth;
    const ih = cropSourceImg.naturalHeight;

    // Scale image to fit canvas, maintaining aspect ratio
    const fitScale = Math.min(cw / iw, ch / ih);
    const drawW = iw * fitScale;
    const drawH = ih * fitScale;
    cropDisplayScale = fitScale;
    cropOffsetX = Math.round((cw - drawW) / 2);
    cropOffsetY = Math.round((ch - drawH) / 2);

    // 1. Draw image centered
    cropCtx.clearRect(0, 0, cw, ch);
    cropCtx.drawImage(cropSourceImg, cropOffsetX, cropOffsetY, drawW, drawH);

    // 2. Dark semi-transparent overlay everywhere EXCEPT the crop rect
    const rx = cropOffsetX + cropRect.x * fitScale;
    const ry = cropOffsetY + cropRect.y * fitScale;
    const rw = cropRect.w * fitScale;
    const rh = cropRect.h * fitScale;

    cropCtx.fillStyle = 'rgba(0,0,0,0.55)';
    cropCtx.fillRect(0, 0, cw, ry);                        // top
    cropCtx.fillRect(0, ry, rx, rh);                        // left
    cropCtx.fillRect(rx + rw, ry, cw - rx - rw, rh);       // right
    cropCtx.fillRect(0, ry + rh, cw, ch - ry - rh);        // bottom

    // 3. White border around crop window
    cropCtx.strokeStyle = '#fff';
    cropCtx.lineWidth = 2;
    cropCtx.setLineDash([6, 3]);
    cropCtx.strokeRect(rx, ry, rw, rh);
    cropCtx.setLineDash([]);

    // 4. Corner handles
    const corners = [
      { x: rx, y: ry },           // nw
      { x: rx + rw, y: ry },      // ne
      { x: rx, y: ry + rh },      // sw
      { x: rx + rw, y: ry + rh }, // se
    ];
    cropCtx.fillStyle = '#fff';
    cropCtx.strokeStyle = 'rgba(0,0,0,0.3)';
    cropCtx.lineWidth = 1;
    corners.forEach(c => {
      cropCtx.fillRect(c.x - HANDLE_SIZE/2, c.y - HANDLE_SIZE/2, HANDLE_SIZE, HANDLE_SIZE);
      cropCtx.strokeRect(c.x - HANDLE_SIZE/2, c.y - HANDLE_SIZE/2, HANDLE_SIZE, HANDLE_SIZE);
    });

    // 5. Edge midpoints (smaller handles)
    const edges = [
      { x: rx + rw/2, y: ry },           // n
      { x: rx + rw/2, y: ry + rh },      // s
      { x: rx, y: ry + rh/2 },           // w
      { x: rx + rw, y: ry + rh/2 },      // e
    ];
    cropCtx.fillStyle = 'rgba(255,255,255,0.7)';
    edges.forEach(e => {
      cropCtx.fillRect(e.x - 4, e.y - 4, 8, 8);
      cropCtx.strokeRect(e.x - 4, e.y - 4, 8, 8);
    });

    // 6. Dimension label
    cropDimLabel.textContent = `${Math.round(cropRect.w)} × ${Math.round(cropRect.h)} px`;
  }

  /** Sync cropRect → hidden inputs → trigger pipeline reprocess */
  function applyCrop() {
    cropX.value = String(Math.round(cropRect.x));
    cropY.value = String(Math.round(cropRect.y));
    cropW.value = String(Math.round(cropRect.w));
    cropH.value = String(Math.round(cropRect.h));
    cropInfo.textContent = `${Math.round(cropRect.w)}×${Math.round(cropRect.h)} px`;
    reprocessPreviews();
  }

  /** Convert display coords to image coords */
  function displayToImage(dx: number, dy: number): { ix: number; iy: number } {
    return {
      ix: (dx - cropOffsetX) / cropDisplayScale,
      iy: (dy - cropOffsetY) / cropDisplayScale,
    };
  }

  /** Hit-test: which handle is at display (px, py)? */
  function hitTest(px: number, py: number): typeof dragMode {
    const rx = cropOffsetX + cropRect.x * cropDisplayScale;
    const ry = cropOffsetY + cropRect.y * cropDisplayScale;
    const rw = cropRect.w * cropDisplayScale;
    const rh = cropRect.h * cropDisplayScale;
    const h = HANDLE_HIT;

    if (Math.abs(px - rx) < h && Math.abs(py - ry) < h) return 'nw';
    if (Math.abs(px - (rx + rw)) < h && Math.abs(py - ry) < h) return 'ne';
    if (Math.abs(px - rx) < h && Math.abs(py - (ry + rh)) < h) return 'sw';
    if (Math.abs(px - (rx + rw)) < h && Math.abs(py - (ry + rh)) < h) return 'se';
    if (Math.abs(px - (rx + rw/2)) < h && Math.abs(py - ry) < h) return 'n';
    if (Math.abs(px - (rx + rw/2)) < h && Math.abs(py - (ry + rh)) < h) return 's';
    if (Math.abs(px - rx) < h && Math.abs(py - (ry + rh/2)) < h) return 'w';
    if (Math.abs(px - (rx + rw)) < h && Math.abs(py - (ry + rh/2)) < h) return 'e';
    if (px > rx && px < rx + rw && py > ry && py < ry + rh) return 'move';
    return null;
  }

  function getEventPos(e: MouseEvent | TouchEvent): { x: number; y: number } {
    const rect = cropCanvas.getBoundingClientRect();
    if ('touches' in e) {
      return { x: e.touches[0].clientX - rect.left, y: e.touches[0].clientY - rect.top };
    }
    return { x: (e as MouseEvent).clientX - rect.left, y: (e as MouseEvent).clientY - rect.top };
  }

  /** Apply aspect ratio constraint to a new width/height */
  function constrainRatio(w: number, h: number, anchorX: number, anchorY: number, anchorW: number, anchorH: number): { w: number; h: number } {
    const ratioVal = getRatioValue(cropRatio);
    if (!ratioVal) return { w, h };
    // Lock height based on width, clamped to image bounds
    const iw = cropSourceImg!.naturalWidth;
    const ih = cropSourceImg!.naturalHeight;
    let cw = w;
    let ch = Math.round(cw / ratioVal);
    if (anchorY + ch > ih) { ch = ih - anchorY; cw = Math.round(ch * ratioVal); }
    if (anchorX + cw > iw) { cw = iw - anchorX; ch = Math.round(cw / ratioVal); }
    return { w: Math.max(1, cw), h: Math.max(1, ch) };
  }

  function onCropPointerDown(e: MouseEvent | TouchEvent) {
    e.preventDefault();
    const pos = getEventPos(e);
    const mode = hitTest(pos.x, pos.y);
    if (!mode) { dragMode = null; return; }
    dragMode = mode;
    dragStart = {
      mx: pos.x, my: pos.y,
      rx: cropRect.x, ry: cropRect.y, rw: cropRect.w, rh: cropRect.h,
    };
    cropCanvas.setPointerCapture((e as any).pointerId ?? 1);
    cropCanvas.style.cursor = mode === 'move' ? 'move' : getResizeCursor(mode);
  }

  function onCropPointerMove(e: MouseEvent | TouchEvent) {
    e.preventDefault();
    if (!cropSourceImg) return;
    const pos = getEventPos(e);
    const iw = cropSourceImg.naturalWidth;
    const ih = cropSourceImg.naturalHeight;

    if (dragMode) {
      const dx = (pos.x - dragStart.mx) / cropDisplayScale;
      const dy = (pos.y - dragStart.my) / cropDisplayScale;
      let { rx, ry, rw, rh } = dragStart;

      if (dragMode === 'move') {
        let nx = Math.max(0, Math.min(iw - rw, rx + dx));
        let ny = Math.max(0, Math.min(ih - rh, ry + dy));
        cropRect = { x: nx, y: ny, w: rw, h: rh };
      } else {
        if (dragMode.includes('e')) {
          rw = Math.max(1, Math.min(iw - rx, rw + dx));
        }
        if (dragMode.includes('w')) {
          const nw = Math.max(1, Math.min(rx + rw, rw - dx));
          rx = rx + rw - nw;
          rw = nw;
        }
        if (dragMode.includes('s')) {
          rh = Math.max(1, Math.min(ih - ry, rh + dy));
        }
        if (dragMode.includes('n')) {
          const nh = Math.max(1, Math.min(ry + rh, rh - dy));
          ry = ry + rh - nh;
          rh = nh;
        }
        // Apply aspect ratio constraint
        const ratioVal = getRatioValue(cropRatio);
        if (ratioVal) {
          if (dragMode === 'nw' || dragMode === 'se') {
            // Corner resize: lock to ratio from the opposite corner
            if (dragMode === 'nw') {
              const origRight = dragStart.rx + dragStart.rw;
              const origBottom = dragStart.ry + dragStart.rh;
              // New right edge = rx + rw (from se), new bottom = ry + rh
              const newW = Math.max(1, Math.min(iw - rx, Math.round(rh * ratioVal)));
              const newH = Math.round(newW / ratioVal);
              if (ry + newH > ih) { /* width-driven already */ }
              rw = newW; rh = newH;
            } else {
              // se: lock from nw corner
              rh = Math.round(rw / ratioVal);
              if (ry + rh > ih) { rh = ih - ry; rw = Math.round(rh * ratioVal); }
            }
          } else if (dragMode === 'ne' || dragMode === 'sw') {
            if (dragMode === 'ne') {
              rh = Math.round(rw / ratioVal);
              ry = dragStart.ry + dragStart.rh - rh;
              if (ry < 0) { ry = 0; rh = dragStart.ry + dragStart.rh; rw = Math.round(rh * ratioVal); }
            } else {
              rh = Math.round(rw / ratioVal);
              if (dragStart.ry + rh > ih) { rh = ih - dragStart.ry; rw = Math.round(rh * ratioVal); }
            }
          }
        }
        cropRect = {
          x: Math.max(0, Math.round(rx)),
          y: Math.max(0, Math.round(ry)),
          w: Math.max(1, Math.round(rw)),
          h: Math.max(1, Math.round(rh)),
        };
      }
      renderCropCanvas();
    } else {
      // Update cursor on hover
      const mode = hitTest(pos.x, pos.y);
      cropCanvas.style.cursor = mode ? (mode === 'move' ? 'move' : getResizeCursor(mode)) : 'crosshair';
    }
  }

  function onCropPointerUp(e: MouseEvent | TouchEvent) {
    if (!dragMode) return;
    dragMode = null;
    cropCanvas.style.cursor = 'crosshair';
    applyCrop();
  }

  function getResizeCursor(mode: string): string {
    if (mode === 'nw' || mode === 'se') return 'nwse-resize';
    if (mode === 'ne' || mode === 'sw') return 'nesw-resize';
    if (mode === 'n' || mode === 's') return 'ns-resize';
    if (mode === 'e' || mode === 'w') return 'ew-resize';
    return 'crosshair';
  }

  // Wire pointer events on crop canvas
  cropCanvas?.addEventListener('pointerdown', onCropPointerDown);
  cropCanvas?.addEventListener('pointermove', onCropPointerMove);
  cropCanvas?.addEventListener('pointerup', onCropPointerUp);
  cropCanvas?.addEventListener('pointerleave', onCropPointerUp);
  // Touch-specific: prevent scrolling while interacting
  cropCanvas?.addEventListener('touchstart', (e) => e.preventDefault(), { passive: false });

  // Aspect ratio preset buttons
  document.querySelectorAll('.crop-ratio-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.crop-ratio-btn').forEach(b => {
        b.className = b.className.replace('bg-accent-soft border-accent/30 text-accent', 'border-border-secondary text-text-secondary hover:bg-surface-secondary hover:text-text-primary');
      });
      btn.classList.add('bg-accent-soft', 'border-accent/30', 'text-accent');
      btn.classList.remove('border-border-secondary', 'text-text-secondary', 'hover:bg-surface-secondary', 'hover:text-text-primary');
      cropRatio = btn.getAttribute('data-crop-ratio') || 'free';

      // If switching to a locked ratio, constrain the current rect
      if (cropRatio !== 'free' && cropSourceImg) {
        const ratioVal = getRatioValue(cropRatio);
        if (ratioVal) {
          const cw = cropRect.w;
          const ch = Math.round(cw / ratioVal);
          const iw = cropSourceImg.naturalWidth;
          const ih = cropSourceImg.naturalHeight;
          if (cropRect.y + ch > ih) {
            cropRect.h = ih - cropRect.y;
            cropRect.w = Math.round(cropRect.h * ratioVal);
          } else {
            cropRect.h = ch;
          }
        }
        renderCropCanvas();
        applyCrop();
      }
    });
  });

  // "Full Image" reset
  document.getElementById('crop-reset-btn')?.addEventListener('click', () => {
    cropX.value = '0'; cropY.value = '0'; cropW.value = '0'; cropH.value = '0';
    if (cropSourceImg) {
      cropRect = { x: 0, y: 0, w: cropSourceImg.naturalWidth, h: cropSourceImg.naturalHeight };
      renderCropCanvas();
    }
    reprocessPreviews();
  });

  // Re-render crop canvas when tab activates or files change
  // Hook into updatePreviews to refresh crop source
  const _origUpdatePreviews = updatePreviews;
  updatePreviews = function() {
    _origUpdatePreviews();
    if (activeTool === 'crop' && files.length > 0) loadCropSource();
  };

  // Also load when activating crop tab from another tool
  const _origActivateTab = activateTab;
  activateTab = function(tab: HTMLElement) {
    _origActivateTab(tab);
    if (activeTool === 'crop' && files.length > 0) loadCropSource();
  };

  // ==========================================
  // ROTATE — Instant on button click
  // ==========================================
  document.querySelectorAll('.rotate-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.rotate-btn').forEach(b => b.classList.remove('bg-accent-soft','text-accent','border-accent/40'));
      btn.classList.add('bg-accent-soft','text-accent','border-accent/40');
      const custom = document.querySelector('[data-rotate-custom]') as HTMLElement;
      custom.classList.toggle('hidden', btn.getAttribute('data-rotate') !== 'custom');
      reprocessPreviews();
    });
  });

  const rotateCustomDeg = document.getElementById('rotate-custom-deg') as HTMLInputElement;
  rotateCustomDeg?.addEventListener('input', debouncedReprocess);

  // ==========================================
  // FILTERS — Instant on button click
  // ==========================================
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('bg-accent-soft','text-accent','border-accent/40'));
      btn.classList.add('bg-accent-soft','text-accent','border-accent/40');
      // 'Reset' filter flushes the entire pipeline so subsequent tools start from raw originals
      if (btn.getAttribute('data-filter') === 'none') {
        pipelineBlobs.clear();
      }
      reprocessPreviews();
    });
  });

  // ==========================================
  // PDF COMPRESS — Live on slider change
  // ==========================================
  const pdfCompQuality = document.getElementById('pdfcomp-quality') as HTMLInputElement;
  const pdfCompQVal = document.getElementById('pdfcomp-qval') as HTMLElement;
  const pdfCompScale = document.getElementById('pdfcomp-scale') as HTMLInputElement;
  const pdfCompScaleVal = document.getElementById('pdfcomp-scaleval') as HTMLElement;

  pdfCompQuality?.addEventListener('input', () => {
    pdfCompQVal.textContent = pdfCompQuality.value;
    debouncedReprocess();
  });
  pdfCompScale?.addEventListener('input', () => {
    pdfCompScaleVal.textContent = (parseInt(pdfCompScale.value) / 100).toFixed(2);
    debouncedReprocess();
  });

  // Utils
  function formatBytes(b: number) { return b<1024?b+' B':b<1048576?(b/1024).toFixed(1)+' KB':(b/1048576).toFixed(2)+' MB'; }
  function toast(msg: string, type: 'error'|'info') {
    const t = document.createElement('div');
    t.className = `fixed bottom-6 right-6 z-50 rounded-xl px-5 py-3 text-sm font-medium shadow-lg animate-soft ${type==='error'?'bg-red-500 text-white':'bg-surface-card border border-border-primary text-text-primary'}`;
    t.textContent = msg; document.body.appendChild(t);
    setTimeout(() => { t.style.opacity='0'; setTimeout(()=>t.remove(),300); }, 3500);
  }
</script>
