---
export interface Props {
  items: { question: string; answer: string }[];
  /** First N items open by default (default: 0, all closed) */
  openFirst?: number;
}

const { items, openFirst = 0 } = Astro.props;
---

<div class="faq-accordion divide-y divide-border-secondary rounded-2xl border border-border-secondary bg-surface-card shadow-sm" role="list">
  {
    items.map((_, index) => (
      <div class="faq-item group" role="listitem">
        <button
          type="button"
          class="faq-trigger flex w-full cursor-pointer items-center justify-between gap-4 px-6 py-5 text-left text-base font-medium text-text-primary transition-colors duration-200 hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
          aria-expanded={index < openFirst ? 'true' : 'false'}
          data-index={index}
        >
          <span>{items[index].question}</span>
          <span class="faq-icon relative flex h-5 w-5 flex-shrink-0 items-center justify-center">
            <svg
              class="faq-icon-plus absolute h-4 w-4 text-text-tertiary transition-all duration-300"
              fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14" />
            </svg>
            <svg
              class="faq-icon-minus absolute h-4 w-4 text-accent transition-all duration-300"
              fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14" />
            </svg>
          </span>
        </button>
        <div
          class="faq-panel overflow-hidden transition-all duration-300 ease-in-out"
          style={index < openFirst ? '' : 'max-height:0'}
        >
          <div class="px-6 pb-5">
            <p class="text-sm leading-relaxed text-text-secondary">{items[index].answer}</p>
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  function initFAQ(root: HTMLElement) {
    const triggers = root.querySelectorAll<HTMLButtonElement>('.faq-trigger');

    triggers.forEach(trigger => {
      const panel = trigger.nextElementSibling as HTMLElement;
      const plus = trigger.querySelector('.faq-icon-plus') as SVGElement;
      const minus = trigger.querySelector('.faq-icon-minus') as SVGElement;
      if (!panel || !plus || !minus) return;

      // Set initial state from aria-expanded
      const open = trigger.getAttribute('aria-expanded') === 'true';
      setIcon(plus, minus, open);
      if (open) panel.style.maxHeight = panel.scrollHeight + 'px';

      trigger.addEventListener('click', () => {
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          panel.style.maxHeight = '0px';
          trigger.setAttribute('aria-expanded', 'false');
          setIcon(plus, minus, false);
        } else {
          panel.style.maxHeight = panel.scrollHeight + 'px';
          trigger.setAttribute('aria-expanded', 'true');
          setIcon(plus, minus, true);
        }
      });
    });

    // Recalc heights on window resize
    let timer: number;
    window.addEventListener('resize', () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        triggers.forEach(trigger => {
          const panel = trigger.nextElementSibling as HTMLElement;
          if (panel && trigger.getAttribute('aria-expanded') === 'true') {
            panel.style.maxHeight = panel.scrollHeight + 'px';
          }
        });
      }, 150);
    });
  }

  function setIcon(plus: SVGElement, minus: SVGElement, open: boolean) {
    plus.style.opacity = open ? '0' : '1';
    plus.style.transform = open ? 'rotate(90deg)' : 'rotate(0deg)';
    minus.style.opacity = open ? '1' : '0';
    minus.style.transform = open ? 'rotate(0deg)' : 'rotate(-90deg)';
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLElement>('.faq-accordion').forEach(initFAQ);
  });
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.faq-accordion').forEach(initFAQ);
  });
</script>

<style>
  .faq-panel { max-height: 0; }
</style>
